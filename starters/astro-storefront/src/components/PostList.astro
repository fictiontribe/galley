---
// One page of a story listing — the journal or a tag — with the pager below
// it. With `lead`, the first story on the first page is set large.
import type { Page } from "astro";
import PostCard from "./PostCard.astro";
import Icon from "./Icon.astro";
import { fill, labels } from "../lib/site";
import type { Post } from "../lib/journal";

interface Props {
  listing: Page<Post>;
  lead?: boolean;
}

const { listing, lead = false } = Astro.props;
---

{
  listing.data.length > 0 ? (
    <ul class="post-list" role="list">
      {listing.data.map((post, i) => (
        <li class:list={{ "post-list__lead": lead && i === 0 && listing.currentPage === 1 }}>
          <PostCard post={post} headingLevel={2} eager={i === 0} />
        </li>
      ))}
    </ul>
  ) : (
    <p class="lede">{labels.journal.empty}</p>
  )
}

{
  listing.lastPage > 1 && (
    <nav class="pager" aria-label={labels.journal.pagination}>
      {listing.url.prev ? (
        <a class="text-link" href={listing.url.prev}>
          <Icon name="arrow-left" size={16} />
          {labels.journal.newer}
        </a>
      ) : (
        <span />
      )}
      <span class="label">{fill(labels.journal.pageOf, { current: listing.currentPage, total: listing.lastPage })}</span>
      {listing.url.next ? (
        <a class="text-link" href={listing.url.next}>
          {labels.journal.older}
          <Icon name="arrow-right" size={16} />
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}

<style>
  .post-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-2xl) var(--gutter);
    padding: 0;
    list-style: none;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-m);
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-m);
    border-block-start: var(--border-width) solid var(--tone-line);
  }

  .pager > :last-child {
    justify-self: end;
  }

  @media (min-width: 60rem) {
    .post-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .post-list__lead {
      grid-column: 1 / -1;
    }

    .post-list__lead :global(.post-card) {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      gap: var(--gutter);
      align-items: end;
    }

    .post-list__lead :global(.post-card__title) {
      font-size: var(--step-4);
      line-height: 1;
    }

    .post-list__lead :global(.post-card__text) {
      font-size: var(--step-1);
    }
  }
</style>
