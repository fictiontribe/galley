---
// The closing invitation. With `image` the photograph stands beside the words,
// on the page's one split line.
import Section from "../Section.astro";
import Actions from "../Actions.astro";
import Media from "../Media.astro";
import { inline, paragraphs, type Link, type Tone } from "../../lib/site";

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  heading: string;
  text?: string;
  cta: Link;
  secondaryCta?: Link;
  image?: string;
  imageAlt?: string;
  align?: "left" | "center";
  index?: number;
  level?: number;
  block?: { key: string; type: string };
}

const { id, tone = "accent", eyebrow, heading, text, cta, secondaryCta, image, imageAlt = "", align = "left", index = 0, level = 2, block } = Astro.props;
const headingId = `${id ?? `section-${index}`}-heading`;
const Heading = (level === 1 ? "h1" : "h2") as "h1" | "h2";
---

<Section type="cta" id={id} tone={tone} labelledby={headingId} block={block}>
  <div class:list={["cta", `cta--${align}`, { "cta--image": image }]}>
    <div class="cta__copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <Heading id={headingId} class="cta__heading" set:html={inline(heading)} />
      {
        text && (
          <div class="cta__text">
            {paragraphs(text).map((part) => (
              <p>{part}</p>
            ))}
          </div>
        )
      }
      <Actions cta={cta} secondaryCta={secondaryCta} />
    </div>
    {
      image && (
        <div class="cta__figure frame">
          <Media src={image} alt={imageAlt} ratio="portrait" class="cta__media media--capped" />
        </div>
      )
    }
  </div>
</Section>

<style>
  .cta {
    display: grid;
    gap: var(--space-l) var(--gutter);
    align-items: start;
  }

  .cta__copy {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    max-inline-size: 48rem;
  }

  .cta__heading {
    color: inherit;
  }

  .cta__text {
    display: grid;
    gap: var(--space-xs);
    max-inline-size: 32em;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--tone-muted);
  }

  .cta--center:not(.cta--image) .cta__copy {
    justify-items: center;
    margin-inline: auto;
    text-align: center;
  }

  @media (min-width: 56rem) {
    .cta--image {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .cta--image .cta__copy {
      grid-column: 1 / span 6;
      grid-row: 1;
      align-self: center;
    }

    .cta--image .cta__figure {
      grid-column: 8 / -1;
      grid-row: 1;
    }
  }
</style>
