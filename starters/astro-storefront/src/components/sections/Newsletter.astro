---
// A short sign-up: heading, text and the sign-up form, with an optional
// photograph beside it. The form is a file in src/content/forms/ (`form`,
// default "newsletter"), rendered by the site kit: its fields, wording and
// where it sends (the Galley inbox by default) live there.
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import Media from "../Media.astro";
import { Form } from "../../galley/components/index.js";
import type { Tone } from "../../lib/site";

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  heading: string;
  text?: string;
  form?: string | { id: string };
  image?: string;
  imageAlt?: string;
  layout?: "inline" | "stacked";
  index?: number;
  level?: number;
  block?: { key: string; type: string };
}

const { id, tone = "muted", eyebrow, heading, text, form = "newsletter", image, imageAlt = "", layout = "inline", index = 0, level = 2, block } = Astro.props;
const headingId = `${id ?? `section-${index}`}-heading`;
const formId = typeof form === "string" ? form : form.id;
---

<Section type="newsletter" id={id} tone={tone} labelledby={headingId} block={block}>
  <div class:list={["newsletter", `newsletter--${layout}`, { "newsletter--image": image }]}>
    <div class="newsletter__copy">
      <SectionHeader eyebrow={eyebrow} heading={heading} text={text} level={level} headingId={headingId} class="newsletter__header" />
      <Form id={formId} submitClass="button" class="newsletter__form" />
    </div>
    {
      image && (
        <div class="newsletter__figure frame">
          <Media src={image} alt={imageAlt} ratio="portrait" class="newsletter__media media--capped" />
        </div>
      )
    }
  </div>
</Section>

<style>
  .newsletter {
    display: grid;
    gap: var(--space-l) var(--gutter);
    align-items: start;
  }

  .newsletter__copy {
    display: grid;
    gap: var(--space-l);
    align-content: start;
    max-inline-size: 40rem;
  }

  .newsletter__copy :global(.newsletter__header) {
    margin-block-end: 0;
  }


  @media (min-width: 56rem) {
    .newsletter--image {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .newsletter--image .newsletter__copy {
      grid-column: 1 / span 6;
      grid-row: 1;
      align-self: center;
    }

    .newsletter--image .newsletter__figure {
      grid-column: 8 / -1;
      grid-row: 1;
    }
  }
</style>
