---
// A row of products from the shop: picked by handle, or a collection's
// first few. Prices and stock come from the store when the site is built.
// A handle the store no longer has is left out.
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import Actions from "../Actions.astro";
import ProductCard from "../shop/ProductCard.astro";
import { collectionProducts, getShopCollection, productsByHandle } from "../../lib/shop/data";
import type { Link, Tone } from "../../lib/site";

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  heading: string;
  text?: string;
  products?: string[];
  collection?: string;
  limit?: number;
  columns?: number;
  ratio?: "portrait" | "square";
  cta?: Link;
  index?: number;
  level?: number;
  block?: { key: string; type: string };
}

const { id, tone, eyebrow, heading, text, products = [], collection, limit = 4, columns = 4, ratio = "portrait", cta, index = 0, level = 2, block } = Astro.props;
const headingId = `${id ?? `section-${index}`}-heading`;
const source = products.length ? await productsByHandle(products) : await (async () => {
  const found = await getShopCollection(collection);

  return found ? collectionProducts(found) : [];
})();
const shown = source.slice(0, limit);
---

<Section type="product-rail" id={id} tone={tone} labelledby={headingId} block={block}>
  <div class="rail__head">
    <SectionHeader eyebrow={eyebrow} heading={heading} text={text} level={level} headingId={headingId} class="rail__header" />
    <Actions secondaryCta={cta} />
  </div>
  <ul class="rail" role="list" style={`--columns: ${columns}`}>
    {
      shown.map((product) => (
        <li>
          <ProductCard product={product} ratio={ratio} sizes={`(min-width: 60rem) ${Math.round(100 / columns)}vw, 50vw`} />
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .rail__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-s) var(--space-xl);
    margin-block-end: var(--space-xl);
  }

  .rail__head :global(.rail__header) {
    margin-block-end: 0;
  }

  .rail {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl) var(--gutter);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 60rem) {
    .rail {
      grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    }
  }
</style>
