---
// Every page's <html>, <head>, header and footer. Titles, descriptions and
// share images come from the page, falling back to src/data/site.json.
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/galley-kit.css";
import tokensSource from "../styles/tokens.css?raw";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Scripts } from "../galley/components/index.js";
import { absolute, fill, plain, site, starterNotice, withBase } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  /** Share image path, e.g. /images/blog/loft.webp. */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  /** Leave the title as written instead of applying site.titleTemplate. */
  bareTitle?: boolean;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  tags?: string[];
  /** Where the page really lives, when it was published elsewhere first. */
  canonical?: string;
}

const {
  title,
  description = site.description,
  image = site.shareImage,
  imageAlt = site.shareImageAlt,
  noindex = false,
  bareTitle = false,
  type = "website",
  publishedTime,
  modifiedTime,
  author,
  tags = [],
  canonical: canonicalOverride,
} = Astro.props;

const pageTitle = bareTitle ? plain(title) : fill(site.titleTemplate, { title: plain(title), site: site.name });
// A page kept out of search (the 404 page, `noindex: true`) gets no canonical address.
const canonical = noindex ? undefined : (canonicalOverride ?? absolute(Astro.url.pathname));
const shareImage = absolute(withBase(image));

// Preload the look's reading fonts, named on the `preload:` line of
// tokens.css, so the first paint is already in the right type.
const fontFiles = import.meta.glob("../../node_modules/@fontsource-variable/*/files/*-latin-*-normal.woff2", {
  query: "?url",
  import: "default",
  eager: true,
}) as Record<string, string>;
const preloadNames = (/preload:\s*([^\n*]+)/.exec(tokensSource)?.[1] ?? "").trim().split(/\s+/).filter(Boolean);
const preloads = preloadNames
  .map((name) => Object.entries(fontFiles).find(([path]) => path.endsWith(`/${name}.woff2`))?.[1])
  .filter((url): url is string => Boolean(url));
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    {/* The reader's choice of light or dark, applied before the first paint. */}
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <Scripts placement="head" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    {preloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="sitemap" href={withBase("/sitemap.xml")} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={withBase("/rss.xml")} />
    <link rel="alternate" type="application/feed+json" title={site.name} href={withBase("/feed.json")} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale.replace("-", "_")} />
    <meta property="og:title" content={plain(title)} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {author && <meta property="article:author" content={author} />}
    {author && <meta name="author" content={author} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={plain(title)} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {
      starterNotice && (
        <script is:inline>
          try {
            if (localStorage.getItem("starter-notice") === "hidden") document.documentElement.classList.add("starter-notice-hidden");
          } catch {}
        </script>
      )
    }
  </head>
  <body>
    <Scripts placement="body-start" />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Scripts placement="body-end" />
  </body>
</html>
