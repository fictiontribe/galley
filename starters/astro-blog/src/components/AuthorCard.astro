---
// Who wrote it: portrait, name, role, the short bio and a link to their page.
import Media from "./Media.astro";
import { authorUrl, type Author } from "../lib/blog";
import { fill, inline, labels } from "../lib/site";

interface Props {
  author: Author;
  /** Set the heading over the card ("About the author"). */
  heading?: string;
}

const { author, heading } = Astro.props;
const { name, role, photo, photoAlt, bio } = author.data;
---

<section class="author-card" aria-label={heading ?? name}>
  <Media src={photo} alt={photoAlt ?? ""} ratio="1/1" sizes="6rem" class="author-card__photo" />
  <div class="author-card__body">
    {heading && <p class="author-card__heading">{heading}</p>}
    <p class="author-card__name">
      <a href={authorUrl(author.id)}>{name}</a>
    </p>
    <p class="author-card__role">{role}</p>
    <p class="author-card__bio" set:html={inline(bio)} />
    <a class="text-link" href={authorUrl(author.id)}>{fill(labels.post.moreBy, { name })}</a>
  </div>
</section>

<style>
  .author-card {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--space-m);
    align-items: start;
    font-family: var(--font-ui);
  }

  .author-card :global(.author-card__photo) {
    border-radius: 50%;
  }

  .author-card__body {
    display: grid;
    gap: var(--space-3xs);
    justify-items: start;
  }

  .author-card__heading {
    margin-block-end: var(--space-3xs);
    color: var(--tone-muted);
    font-size: var(--step--2);
    font-weight: var(--weight-ui-strong);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .author-card__name {
    font-family: var(--font-display);
    font-variation-settings: "opsz" var(--opsz-display);
    font-size: var(--step-2);
    font-weight: var(--weight-display);
    font-style: var(--display-style);
    letter-spacing: var(--tracking-display);
    line-height: 1.1;
  }

  .author-card__name a {
    text-decoration: none;
  }

  .author-card__name a:hover {
    color: var(--tone-accent);
  }

  .author-card__role {
    color: var(--tone-muted);
    font-size: var(--step--1);
  }

  .author-card__bio {
    margin-block: var(--space-2xs) var(--space-xs);
    max-inline-size: 36em;
    font-size: var(--step--1);
    line-height: 1.55;
  }

  @media (min-width: 40rem) {
    .author-card {
      grid-template-columns: 6rem 1fr;
    }
  }
</style>
