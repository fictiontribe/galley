---
// The points to take away, in a box. A post's own `takeaways` in front matter
// show the same way above the post, titled "In short".
// Fields: src/content.config.ts → takeawaysFields.
import { inline, labels } from "../../lib/site";

interface Props {
  title?: string;
  items: string[];
}

const { title = labels.post.inShort, items } = Astro.props;
---

<aside class="takeaways">
  <p class="takeaways__title">{title}</p>
  <ul role="list" class="takeaways__list">
    {items.map((item) => <li set:html={inline(item)} />)}
  </ul>
</aside>

<style>
  .takeaways {
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    border-radius: var(--radius-l);
    background: var(--tone-accent-soft);
    font-family: var(--font-ui);
  }

  .takeaways__title {
    margin-block-end: var(--space-xs);
    color: var(--tone-accent);
    font-size: var(--step--2);
    font-weight: var(--weight-ui-strong);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .takeaways__list {
    display: grid;
    gap: var(--space-xs);
    padding: 0;
    list-style: none;
    counter-reset: takeaway;
    font-size: var(--step-0);
    line-height: 1.5;
  }

  .takeaways__list li {
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    counter-increment: takeaway;
  }

  .takeaways__list li::before {
    content: counter(takeaway);
    color: var(--tone-accent);
    font-weight: var(--weight-ui-strong);
    font-variant-numeric: tabular-nums;
  }
</style>
