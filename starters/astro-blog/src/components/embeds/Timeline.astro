---
// Dated events, in order, on a line. Fields: src/content.config.ts → timelineFields.
import { inline } from "../../lib/site";

interface Props {
  title?: string;
  items: Array<{ date: string; title: string; text?: string }>;
}

const { title, items } = Astro.props;
---

<figure class="timeline">
  {title && <p class="embed__title">{title}</p>}
  <ol role="list" class="timeline__list">
    {
      items.map((item) => (
        <li class="timeline__item">
          <p class="timeline__date">{item.date}</p>
          <div class="timeline__body">
            <p class="timeline__title" set:html={inline(item.title)} />
            {item.text && <p class="timeline__text" set:html={inline(item.text)} />}
          </div>
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .timeline {
    container-type: inline-size;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-s);
    font-family: var(--font-ui);
  }

  .timeline__list {
    padding: 0;
    list-style: none;
  }

  .timeline__item {
    position: relative;
    display: grid;
    gap: var(--space-3xs);
    padding-block-end: var(--space-m);
    padding-inline-start: var(--space-l);
  }

  .timeline__item::before {
    content: "";
    position: absolute;
    inset-inline-start: 0.3rem;
    inset-block: 0.55rem 0;
    border-inline-start: var(--border-width) solid var(--tone-line-strong);
  }

  .timeline__item:last-child::before {
    display: none;
  }

  .timeline__item::after {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.35rem;
    inline-size: 0.65rem;
    block-size: 0.65rem;
    border-radius: 50%;
    background: var(--tone-bg);
    border: var(--rule-width) solid var(--tone-accent);
  }

  .timeline__date {
    color: var(--tone-accent);
    font-size: var(--step--2);
    font-weight: var(--weight-ui-strong);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .timeline__title {
    font-size: var(--step-0);
    font-weight: var(--weight-ui-strong);
    line-height: 1.35;
  }

  .timeline__text {
    margin-block-start: var(--space-3xs);
    color: var(--tone-muted);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  @container (min-width: 34rem) {
    .timeline__item {
      grid-template-columns: 8rem 1fr;
      gap: var(--space-m);
    }

    .timeline__date {
      padding-block-start: 0.2em;
    }
  }
</style>
