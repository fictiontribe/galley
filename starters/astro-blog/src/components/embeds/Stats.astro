---
// A few figures, set large, each with what it counts and, optionally, how it
// moved. Fields: src/content.config.ts → statsFields.
import { labels } from "../../lib/site";

interface Props {
  title?: string;
  items: Array<{ value: string; label: string; change?: string; trend?: "good" | "bad" | "neutral" }>;
  source?: string;
}

const { title, items, source } = Astro.props;
---

<figure class="stats">
  {title && <p class="embed__title">{title}</p>}
  <dl class="stats__list" style={`--count: ${items.length}`}>
    {
      items.map((item) => (
        <div class="stats__item">
          <dt class="stats__label">{item.label}</dt>
          <dd class="stats__value">
            {item.value}
            {item.change && <span class:list={["stats__change", `is-${item.trend ?? "neutral"}`]}>{item.change}</span>}
          </dd>
        </div>
      ))
    }
  </dl>
  {source && <figcaption class="embed__source">{labels.embeds.source}: {source}</figcaption>}
</figure>

<style>
  .stats {
    container-type: inline-size;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-s);
    font-family: var(--font-ui);
  }

  .stats__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block-start: var(--rule-width) solid var(--tone-text);
  }

  .stats__item {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--space-3xs);
    padding: var(--space-s) var(--space-s) var(--space-s) 0;
    border-block-end: var(--border-width) solid var(--tone-line);
  }

  .stats__value {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1em 0.5em;
    font-family: var(--font-display);
    font-variation-settings: "opsz" var(--opsz-display);
    font-size: var(--step-5);
    font-weight: var(--weight-display);
    font-style: var(--display-style);
    letter-spacing: var(--tracking-display);
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .stats__label {
    color: var(--tone-muted);
    font-size: var(--step--1);
    line-height: 1.35;
  }

  .stats__change {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: var(--weight-ui-strong);
    letter-spacing: 0;
    color: var(--tone-muted);
  }

  .stats__change.is-good {
    color: var(--color-good);
  }

  .stats__change.is-bad {
    color: var(--color-bad);
  }

  @container (min-width: 40rem) {
    .stats__list {
      grid-template-columns: repeat(min(var(--count), 4), minmax(0, 1fr));
    }

    .stats__item + .stats__item {
      padding-inline-start: var(--space-s);
      border-inline-start: var(--border-width) solid var(--tone-line);
    }
  }
</style>
