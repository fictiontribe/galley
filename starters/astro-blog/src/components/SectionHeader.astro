---
// Eyebrow, heading and text at the top of a section. `*word*` in the heading
// is set in the accent; the text is Markdown.
import { inline, markdown } from "../lib/site";

interface Props {
  eyebrow?: string;
  heading?: string;
  text?: string;
  level?: number;
  headingId?: string;
  align?: "left" | "center";
  class?: string;
}

const { eyebrow, heading, text, level = 2, headingId, align = "left", class: className } = Astro.props;
const Heading = `h${Math.min(Math.max(level, 1), 3)}` as "h1" | "h2" | "h3";
---

{
  (eyebrow || heading || text) && (
    <header class:list={["section-header", `section-header--${align}`, className]}>
      {eyebrow && <p class="kicker">{eyebrow}</p>}
      {heading && <Heading class="section-heading" id={headingId} set:html={inline(heading)} />}
      {text && <div class="section-header__text" set:html={markdown(text)} />}
    </header>
  )
}

<style>
  .section-header {
    display: grid;
    gap: var(--space-xs);
    max-inline-size: 46rem;
  }

  .section-header--center {
    justify-items: center;
    margin-inline: auto;
    text-align: center;
  }

  .section-header__text {
    max-inline-size: 36em;
    color: var(--tone-muted);
    font-family: var(--font-text);
    font-variation-settings: "opsz" var(--opsz-text);
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .section-header__text :global(* + *) {
    margin-block-start: 0.6em;
  }

  .section-header__text :global(a) {
    color: var(--tone-text);
  }
</style>
