---
// One entry of the pages collection: its sections, then its Markdown body (if
// the file has one) in the reading column. A page with no sections gets a
// plain title header, so it still has an <h1>.
import { render, type CollectionEntry } from "astro:content";
import Sections from "./Sections.astro";

interface Props {
  page: CollectionEntry<"pages">;
}

const { page } = Astro.props;
const { Content } = await render(page);
const sections = page.data.sections;
const hasBody = Boolean(page.body?.trim());
---

{
  sections.length > 0 ? (
    <Sections sections={sections} title={page.data.title} />
  ) : (
    <header class="page-head container">
      <div class="page-head__inner">
        <h1 class="page-head__title">{page.data.title}</h1>
        <p class="lede">{page.data.description}</p>
      </div>
    </header>
  )
}
<slot />
{
  hasBody && (
    <div class="page-body flow-grid prose">
      <Content />
    </div>
  )
}

<style>
  .page-body {
    padding-block: var(--space-l) var(--space-section);
  }
</style>
