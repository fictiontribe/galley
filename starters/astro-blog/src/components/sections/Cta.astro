---
// A closing invitation: a heading, a line and one or two buttons.
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import { withBase, type Link, type Tone } from "../../lib/site";

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  heading: string;
  text?: string;
  cta: Link;
  secondaryCta?: Link;
  index?: number;
  level?: number;
  block?: { key: string; type: string };
}

const { id, tone = "muted", eyebrow, heading, text, cta, secondaryCta, index = 0, level = 2, block } = Astro.props;
const headingId = `${id ?? `section-${index}`}-heading`;
---

<Section type="cta" id={id} tone={tone} labelledby={headingId} block={block}>
  <div class="cta">
    <SectionHeader eyebrow={eyebrow} heading={heading} text={text} level={level} headingId={headingId} />
    <div class="cta__actions">
      <a class="button" href={withBase(cta.href)}>{cta.label}</a>
      {secondaryCta && <a class="button button--ghost" href={withBase(secondaryCta.href)}>{secondaryCta.label}</a>}
    </div>
  </div>
</Section>

<style>
  .cta {
    display: grid;
    gap: var(--space-l) var(--gutter);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  @media (min-width: 56rem) {
    .cta {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
</style>
