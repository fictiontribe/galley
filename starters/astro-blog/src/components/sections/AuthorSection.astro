---
// One author, on a page: portrait, name, role and bio, with a link to their
// posts. The bio is the section's own `text`, else the author's short bio.
import { getEntry } from "astro:content";
import Section from "../Section.astro";
import Media from "../Media.astro";
import { authorUrl, refId } from "../../lib/blog";
import { inline, markdown, withBase, type Link, type Tone } from "../../lib/site";

interface Props {
  id?: string;
  tone?: Tone;
  author: string | { id: string };
  heading?: string;
  text?: string;
  cta?: Link;
  index?: number;
  level?: number;
  block?: { key: string; type: string };
}

const { id, tone = "default", author: ref, heading, text, cta, index = 0, level = 2, block } = Astro.props;
const author = await getEntry("authors", refId(ref) ?? "");
const headingId = `${id ?? `section-${index}`}-heading`;
const Heading = level === 1 ? "h1" : "h2";
---

{
  author && (
    <Section type="author" id={id} tone={tone} labelledby={headingId} block={block}>
      <div class="author-section">
        <div class="author-section__photo">
          <Media src={author.data.photo} alt={author.data.photoAlt ?? ""} ratio="4/5" sizes="(min-width: 56rem) 24rem, 100vw" />
        </div>
        <div class="author-section__copy">
          <p class="kicker">{author.data.role}</p>
          <Heading class="section-heading" id={headingId} set:html={inline(heading ?? author.data.name)} />
          <div class="author-section__text prose" set:html={markdown(text ?? author.data.bio)} />
          <a class="button button--ghost" href={withBase(cta?.href) ?? authorUrl(author.id)}>
            {cta?.label ?? author.data.name}
          </a>
        </div>
      </div>
    </Section>
  )
}

<style>
  .author-section {
    display: grid;
    gap: var(--space-l) var(--gutter);
    align-items: center;
  }

  .author-section__photo {
    max-inline-size: 24rem;
  }

  .author-section__copy {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
    max-inline-size: 38rem;
  }

  .author-section__text {
    font-size: var(--step-1);
  }

  @media (min-width: 56rem) {
    .author-section {
      grid-template-columns: 5fr 7fr;
    }
  }
</style>
