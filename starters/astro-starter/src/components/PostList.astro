---
// One page of a post listing — the journal or a tag — with the pager below
// it. The first post on the first page of the journal is set as a spread.
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import PostCard from "./PostCard.astro";
import Icon from "./Icon.astro";
import { fill, labels } from "../lib/site";

interface Props {
  listing: Page<CollectionEntry<"blog">>;
  /** Set the first post large on the first page. */
  lead?: boolean;
}

const { listing, lead = false } = Astro.props;
---

{
  listing.data.length > 0 ? (
    <ul class="post-list" role="list">
      {listing.data.map((post, i) => (
        <li class:list={{ "post-list__lead": lead && i === 0 && listing.currentPage === 1 }}>
          <PostCard post={post} headingLevel={2} eager={i === 0} />
        </li>
      ))}
    </ul>
  ) : (
    <p class="lede">{labels.blog.empty}</p>
  )
}

{
  listing.lastPage > 1 && (
    <nav class="pager" aria-label={labels.blog.pagination}>
      {listing.url.prev ? (
        <a class="text-link" href={listing.url.prev}>
          <Icon name="arrow-left" size={16} />
          {labels.blog.newer}
        </a>
      ) : (
        <span />
      )}
      <span class="pager__status">{fill(labels.blog.pageOf, { current: listing.currentPage, total: listing.lastPage })}</span>
      {listing.url.next ? (
        <a class="text-link" href={listing.url.next}>
          {labels.blog.older}
          <Icon name="arrow-right" size={16} />
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}

<style>
  .post-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-2xl) var(--space-l);
    padding: 0;
    list-style: none;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-m);
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-m);
    border-block-start: var(--border-width) solid var(--tone-line);
  }

  .pager > :last-child {
    justify-self: end;
  }

  .pager__status {
    font-size: var(--step--2);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--tone-muted);
  }

  @media (min-width: 60rem) {
    .post-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .post-list__lead {
      grid-column: 1 / -1;
      padding-block-end: var(--space-xl);
      border-block-end: var(--border-width) solid var(--tone-line);
    }

    .post-list__lead :global(.post-card) {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-2xl);
      align-items: center;
    }

    .post-list__lead :global(.post-card__title) {
      font-size: var(--step-4);
      line-height: 1.06;
    }

    .post-list__lead :global(.post-card__text) {
      font-size: var(--step-0);
    }
  }
</style>
