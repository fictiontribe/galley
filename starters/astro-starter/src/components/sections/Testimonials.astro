---
// Editorial ledger of shorter client remarks in 2 or 3 columns, separated by
// architectural top hairlines (zero boxed cards).
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import type { BlockMarker, Tone } from "../../lib/site";

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  heading?: string;
  columns?: number;
  items: Array<{ quote: string; name: string; role?: string }>;
  index?: number;
  level?: number;
  block?: BlockMarker;
}

const { id, tone, eyebrow, heading, columns = 3, items, index = 0, level = 2, block } = Astro.props;
const headingId = heading ? `${id ?? `section-${index}`}-heading` : undefined;
---

<Section type="testimonials" block={block} id={id} tone={tone} labelledby={headingId}>
  <SectionHeader eyebrow={eyebrow} heading={heading} level={level} headingId={headingId} />
  <ul class="quotes" role="list" style={`--columns: ${columns}`}>
    {
      items.map((item) => (
        <li>
          <figure class="quote">
            <blockquote class="quote__text">
              <p>{item.quote}</p>
            </blockquote>
            <figcaption class="quote__by">
              <span class="quote__name">{item.name}</span>
              {item.role && <span class="quote__role">{item.role}</span>}
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-xl) var(--space-l);
    padding: 0;
    list-style: none;
  }

  .quote {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-m);
    height: 100%;
    padding-block-start: var(--space-m);
    border-block-start: var(--border-width) solid var(--tone-line);
  }

  .quote__text {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-style: italic;
    font-optical-sizing: auto;
    line-height: 1.42;
  }

  .quote__text p::before {
    content: open-quote;
  }

  .quote__text p::after {
    content: close-quote;
  }

  .quote__by {
    display: grid;
    gap: 0.2em;
    padding-block-start: var(--space-s);
  }

  .quote__name {
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
  }

  .quote__role {
    font-size: var(--step--2);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--tone-muted);
  }

  @media (min-width: 64rem) {
    .quotes {
      grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    }
  }
</style>
