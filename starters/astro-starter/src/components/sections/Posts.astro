---
// The latest blog posts, newest first. Optionally only posts with `tag`.
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import PostCard from "../PostCard.astro";
import Icon from "../Icon.astro";
import { getPosts } from "../../lib/posts";
import { withBase, type Link, type BlockMarker, type Tone } from "../../lib/site";

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  heading: string;
  text?: string;
  limit?: number;
  tag?: string;
  cta?: Link;
  index?: number;
  level?: number;
  block?: BlockMarker;
}

const { id, tone, eyebrow, heading, text, limit = 3, tag, cta, index = 0, level = 2, block } = Astro.props;
const headingId = `${id ?? `section-${index}`}-heading`;
const posts = (await getPosts()).filter((post) => !tag || post.data.tags.includes(tag)).slice(0, limit);
---

<Section type="posts" block={block} id={id} tone={tone} labelledby={headingId}>
  <div class="posts__top">
    <SectionHeader eyebrow={eyebrow} heading={heading} text={text} level={level} headingId={headingId} class="posts__header" />
    {
      cta && (
        <a class="text-link posts__all" href={withBase(cta.href)}>
          {cta.label}
          <Icon name="arrow-right" size={16} />
        </a>
      )
    }
  </div>
  <ul class="posts" role="list">
    {
      posts.map((post) => (
        <li>
          <PostCard post={post} headingLevel={level === 1 ? 2 : 3} />
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .posts__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-s) var(--space-l);
    margin-block-end: var(--space-xl);
    padding-block-end: var(--space-m);
    border-block-end: var(--border-width) solid var(--tone-line);
  }

  .posts__top :global(.posts__header) {
    margin-block-end: 0;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-xl) var(--space-l);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 60rem) {
    .posts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
