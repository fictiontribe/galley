---
// Studio address & hours ledger beside the architectural enquiry sheet.
// The form lives in src/content/forms/<id>.json (`form`, default "contact").
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import FormEmbed from "../FormEmbed.astro";
import { withBase, type BlockMarker, type Tone } from "../../lib/site";

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  heading: string;
  text?: string;
  form?: string | { id: string };
  items?: Array<{ label: string; value: string; href?: string }>;
  index?: number;
  level?: number;
  block?: BlockMarker;
}

const { id, tone, eyebrow, heading, text, form = "contact", items = [], index = 0, level = 2, block } = Astro.props;
const headingId = `${id ?? `section-${index}`}-heading`;
---

<Section type="contact" id={id} tone={tone} block={block} labelledby={headingId}>
  <div class="contact">
    <div class="contact__info">
      <SectionHeader eyebrow={eyebrow} heading={heading} text={text} level={level} headingId={headingId} size="small" class="contact__header" />
      {
        items.length > 0 && (
          <dl class="contact__details">
            {items.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.href ? <a href={withBase(item.href)}>{item.value}</a> : item.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>

    <div class="contact__form">
      <FormEmbed form={form} />
    </div>
  </div>
</Section>

<style>
  .contact {
    display: grid;
    gap: var(--space-xl);
  }

  .contact__info {
    display: grid;
    gap: var(--space-l);
    align-content: start;
  }

  .contact__info :global(.contact__header) {
    margin-block-end: 0;
  }

  .contact__details {
    display: grid;
    border-block-end: var(--border-width) solid var(--tone-line);
  }

  .contact__details > div {
    display: grid;
    gap: 0.2em;
    padding-block: var(--space-s);
    border-block-start: var(--border-width) solid var(--tone-line);
  }

  .contact__details dt {
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--tone-muted);
  }

  .contact__details dd {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.3;
  }

  .contact__form {
    align-self: start;
    padding: var(--space-l);
    background: var(--tone-surface);
    border: var(--border-width) solid var(--tone-line);
    border-radius: var(--radius-s);
  }

  @media (min-width: 60rem) {
    .contact {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-2xl);
    }

    .contact__form {
      padding: var(--space-xl);
    }
  }
</style>
