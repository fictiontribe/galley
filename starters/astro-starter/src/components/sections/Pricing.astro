---
// Plans side by side. Set `featured: true` on one plan to give it the inverse
// treatment, and `badge` for the small label above its name.
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import Icon from "../Icon.astro";
import { withBase, type Link, type BlockMarker, type Tone } from "../../lib/site";

interface Plan {
  name: string;
  price: string;
  period?: string;
  text?: string;
  features?: string[];
  cta?: Link;
  featured?: boolean;
  badge?: string;
}

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  heading: string;
  text?: string;
  items: Plan[];
  note?: string;
  index?: number;
  level?: number;
  block?: BlockMarker;
}

const { id, tone, eyebrow, heading, text, items, note, index = 0, level = 2, block } = Astro.props;
const headingId = `${id ?? `section-${index}`}-heading`;
const ItemHeading = (level === 1 ? "h2" : "h3") as "h2" | "h3";
---

<Section type="pricing" block={block} id={id} tone={tone} labelledby={headingId}>
  <SectionHeader eyebrow={eyebrow} heading={heading} text={text} level={level} headingId={headingId} />
  <ul class="plans" role="list" style={`--count: ${items.length}`}>
    {
      items.map((plan) => (
        <li class:list={["plan", { "plan--featured tone-inverse": plan.featured }]}>
          <div class="plan__head">
            {plan.badge && <p class="plan__badge">{plan.badge}</p>}
            <ItemHeading class="plan__name">{plan.name}</ItemHeading>
            <p class="plan__price">
              <span class="plan__amount">{plan.price}</span>
              {plan.period && <span class="plan__period">{plan.period}</span>}
            </p>
            {plan.text && <p class="plan__text">{plan.text}</p>}
          </div>
          {plan.features && plan.features.length > 0 && (
            <ul class="plan__features" role="list">
              {plan.features.map((feature) => (
                <li>
                  <Icon name="check" size={18} />
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          )}
          {plan.cta && (
            <a class:list={["button plan__cta", { "button--secondary": !plan.featured }]} href={withBase(plan.cta.href)}>
              {plan.cta.label}
            </a>
          )}
        </li>
      ))
    }
  </ul>
  {note && <p class="plans__note">{note}</p>}
</Section>

<style>
  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-m);
    padding: 0;
    list-style: none;
  }

  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    padding: var(--space-l);
    background: var(--tone-surface);
    color: var(--tone-text);
    border: var(--border-width) solid var(--tone-line);
    border-radius: var(--radius-m);
  }

  .plan--featured {
    background: var(--tone-bg);
    box-shadow: var(--shadow-raised);
  }

  .plan__head {
    display: grid;
    gap: var(--space-2xs);
  }

  /* Sits on the card's top edge so every plan's name lines up. */
  .plan__badge {
    position: absolute;
    top: 0;
    left: var(--space-l);
    transform: translateY(-50%);
    padding: 0.2em 0.7em;
    border-radius: var(--radius-s);
    background: var(--tone-link);
    color: var(--tone-bg);
    font-size: var(--step--2);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .plan__name {
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: var(--weight-bold);
    letter-spacing: 0;
  }

  .plan__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4em;
  }

  .plan__amount {
    font-family: var(--font-display);
    font-size: var(--step-4);
    letter-spacing: var(--tracking-display);
    line-height: 1.1;
    font-variant-numeric: lining-nums;
  }

  .plan__period,
  .plan__text {
    font-size: var(--step--1);
    color: var(--tone-muted);
  }

  .plan__features {
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-m) 0 0;
    border-block-start: var(--border-width) solid var(--tone-line);
    list-style: none;
    font-size: var(--step--1);
  }

  .plan__features li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-xs);
  }

  .plan__features :global(svg) {
    margin-block-start: 0.15em;
    color: var(--tone-link);
  }

  .plan__cta {
    margin-block-start: auto;
  }

  .plans__note {
    margin-block-start: var(--space-l);
    font-size: var(--step--1);
    color: var(--tone-muted);
    max-width: 48em;
  }

  @media (min-width: 64rem) {
    .plans {
      grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    }
  }
</style>
