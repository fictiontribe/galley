---
// Fixed-fee architectural stage sheets: crisp hairline-bordered schedules with
// numbered stages and hairline specification lines. Set `featured: true` to
// highlight a stage on the inverse ground with an accent top rule.
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import Icon from "../Icon.astro";
import { withBase, type Link, type BlockMarker, type Tone } from "../../lib/site";

interface Plan {
  name: string;
  price: string;
  period?: string;
  text?: string;
  features?: string[];
  cta?: Link;
  featured?: boolean;
  badge?: string;
}

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  heading: string;
  text?: string;
  items: Plan[];
  note?: string;
  index?: number;
  level?: number;
  block?: BlockMarker;
}

const { id, tone, eyebrow, heading, text, items, note, index = 0, level = 2, block } = Astro.props;
const headingId = `${id ?? `section-${index}`}-heading`;
const ItemHeading = (level === 1 ? "h2" : "h3") as "h2" | "h3";
---

<Section type="pricing" block={block} id={id} tone={tone} labelledby={headingId}>
  <SectionHeader eyebrow={eyebrow} heading={heading} text={text} level={level} headingId={headingId} />
  <ul class="plans" role="list" style={`--count: ${items.length}`}>
    {
      items.map((plan, i) => (
        <li class:list={["plan", { "plan--featured tone-inverse": plan.featured }]}>
          <div class="plan__bar">
            <span class="plan__index" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            {plan.badge && <p class="plan__badge">{plan.badge}</p>}
          </div>
          <div class="plan__head">
            <ItemHeading class="plan__name">{plan.name}</ItemHeading>
            <p class="plan__price">
              <span class="plan__amount">{plan.price}</span>
              {plan.period && <span class="plan__period">{plan.period}</span>}
            </p>
            {plan.text && <p class="plan__text">{plan.text}</p>}
          </div>
          {plan.features && plan.features.length > 0 && (
            <ul class="plan__features" role="list">
              {plan.features.map((feature) => (
                <li>
                  <span class="plan__dash" aria-hidden="true" />
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          )}
          {plan.cta && (
            <a class:list={["button plan__cta", { "button--secondary": !plan.featured }]} href={withBase(plan.cta.href)}>
              {plan.cta.label}
              <Icon name="arrow-right" size={16} />
            </a>
          )}
        </li>
      ))
    }
  </ul>
  {note && <p class="plans__note">{note}</p>}
</Section>

<style>
  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-m);
    padding: 0;
    list-style: none;
  }

  .plan {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    padding: var(--space-l);
    background: var(--tone-surface);
    color: var(--tone-text);
    border: var(--border-width) solid var(--tone-line);
    border-radius: var(--radius-s);
  }

  .plan--featured {
    background: var(--tone-bg);
    border-color: var(--tone-line);
    border-block-start: 3px solid var(--tone-link);
  }

  .plan__bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs);
    padding-block-end: var(--space-s);
    border-block-end: var(--border-width) solid var(--tone-line);
  }

  .plan__index {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-style: italic;
    line-height: 1;
    color: var(--tone-link);
    font-variant-numeric: lining-nums tabular-nums;
  }

  .plan__badge {
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--tone-link);
  }

  .plan__head {
    display: grid;
    gap: var(--space-xs);
  }

  .plan__name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: var(--weight-display);
    line-height: 1.15;
  }

  .plan__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45em;
  }

  .plan__amount {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    line-height: 1.05;
    font-variant-numeric: lining-nums;
  }

  .plan__period,
  .plan__text {
    font-size: var(--step--1);
    color: var(--tone-muted);
  }

  .plan__features {
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-m) 0 0;
    border-block-start: var(--border-width) solid var(--tone-line);
    list-style: none;
    font-size: var(--step--1);
  }

  .plan__features li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-xs);
  }

  .plan__dash {
    inline-size: 0.9rem;
    block-size: 1px;
    margin-block-start: 0.72em;
    background: var(--tone-link);
  }

  .plan__cta {
    margin-block-start: auto;
  }

  .plans__note {
    margin-block-start: var(--space-l);
    padding-block-start: var(--space-m);
    border-block-start: var(--border-width) solid var(--tone-line);
    font-size: var(--step--1);
    color: var(--tone-muted);
    max-width: 52em;
  }

  @media (min-width: 64rem) {
    .plans {
      grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    }
  }
</style>
