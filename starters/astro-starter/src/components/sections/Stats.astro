---
// Architectural specification band: monumental display numerals separated
// by crisp horizontal and vertical hairlines, zero card boxes.
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import type { BlockMarker, Tone } from "../../lib/site";

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  heading?: string;
  text?: string;
  columns?: number;
  items: Array<{ value: string; label: string; text?: string }>;
  index?: number;
  level?: number;
  block?: BlockMarker;
}

const { id, tone, eyebrow, heading, text, columns = 4, items, index = 0, level = 2, block } = Astro.props;
const headingId = heading ? `${id ?? `section-${index}`}-heading` : undefined;
---

<Section type="stats" block={block} id={id} tone={tone} labelledby={headingId}>
  <SectionHeader eyebrow={eyebrow} heading={heading} text={text} level={level} headingId={headingId} size="small" />
  <dl class="stats" data-columns={columns} style={`--columns: ${columns}`}>
    {
      items.map((item) => (
        <div class="stat">
          <dt class="stat__label">{item.label}</dt>
          <dd class="stat__value">{item.value}</dd>
          {item.text && <dd class="stat__text">{item.text}</dd>}
        </div>
      ))
    }
  </dl>
</Section>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--space-l);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-block-start: var(--space-m);
    border-block-start: var(--border-width) solid var(--tone-line);
  }

  .stat__label {
    order: 2;
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--tone-text);
  }

  .stat__value {
    order: 1;
    font-family: var(--font-display);
    font-size: var(--step-6);
    font-weight: var(--weight-display);
    font-optical-sizing: auto;
    letter-spacing: var(--tracking-display);
    line-height: 0.96;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--tone-text);
  }

  .stat__text {
    order: 3;
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--tone-muted);
    max-width: 24em;
  }

  @media (min-width: 60rem) {
    .stats {
      grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
      gap: var(--space-xl) 0;
    }

    .stat {
      padding-block: var(--space-m) var(--space-xs);
      padding-inline: var(--space-m);
    }

    .stats[data-columns="2"] > .stat:nth-child(2n + 1),
    .stats[data-columns="3"] > .stat:nth-child(3n + 1),
    .stats[data-columns="4"] > .stat:nth-child(4n + 1) {
      padding-inline-start: 0;
    }

    .stats[data-columns="2"] > .stat:not(:nth-child(2n + 1)),
    .stats[data-columns="3"] > .stat:not(:nth-child(3n + 1)),
    .stats[data-columns="4"] > .stat:not(:nth-child(4n + 1)) {
      border-inline-start: var(--border-width) solid var(--tone-line);
    }

    .stats[data-columns="2"] > .stat:nth-child(2n),
    .stats[data-columns="3"] > .stat:nth-child(3n),
    .stats[data-columns="4"] > .stat:nth-child(4n) {
      padding-inline-end: 0;
    }
  }
</style>
