---
// Questions and answers as native <details> with architectural crosshair
// indicators (+ / −) that work without JavaScript. Answers accept markdown.
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import { markdown, type BlockMarker, type Tone } from "../../lib/site";

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  heading: string;
  text?: string;
  items: Array<{ question: string; answer: string }>;
  index?: number;
  level?: number;
  block?: BlockMarker;
}

const { id, tone, eyebrow, heading, text, items, index = 0, level = 2, block } = Astro.props;
const headingId = `${id ?? `section-${index}`}-heading`;
---

<Section type="faq" block={block} id={id} tone={tone} labelledby={headingId}>
  <div class="faq">
    <SectionHeader eyebrow={eyebrow} heading={heading} text={text} level={level} headingId={headingId} size="small" class="faq__header" />
    <div class="faq__list">
      {
        items.map((item) => (
          <details class="faq__item">
            <summary class="faq__question">
              <span>{item.question}</span>
              <span class="faq__crosshair" aria-hidden="true" />
            </summary>
            <div class="faq__answer prose" set:html={markdown(item.answer)} />
          </details>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .faq {
    display: grid;
    gap: var(--space-l);
  }

  .faq__list {
    border-block-start: var(--border-width) solid var(--tone-line);
  }

  .faq__item {
    border-block-end: var(--border-width) solid var(--tone-line);
  }

  .faq__question {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-m);
    padding-block: var(--space-m);
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.3;
    list-style: none;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:hover {
    color: var(--tone-link);
  }

  .faq__crosshair {
    position: relative;
    flex: none;
    inline-size: 1.1rem;
    block-size: 1.1rem;
    margin-block-start: 0.22em;
    color: var(--tone-link);
  }

  .faq__crosshair::before,
  .faq__crosshair::after {
    content: "";
    position: absolute;
    background: currentColor;
    transition:
      transform var(--duration) var(--ease-out),
      opacity var(--duration) var(--ease-out);
  }

  .faq__crosshair::before {
    inset-inline: 0;
    top: 50%;
    block-size: 1px;
    transform: translateY(-50%);
  }

  .faq__crosshair::after {
    inset-block: 0;
    left: 50%;
    inline-size: 1px;
    transform: translateX(-50%);
  }

  .faq__item[open] .faq__crosshair::after {
    transform: translateX(-50%) scaleY(0);
    opacity: 0;
  }

  .faq__answer {
    padding-block-end: var(--space-l);
    padding-inline-end: var(--space-xl);
    font-size: var(--step--1);
    color: var(--tone-muted);
  }

  @media (min-width: 60rem) {
    .faq {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-2xl);
      align-items: start;
    }

    .faq :global(.faq__header) {
      position: sticky;
      top: var(--space-l);
    }
  }
</style>
