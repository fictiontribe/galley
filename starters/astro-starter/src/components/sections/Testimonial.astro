---
// Editorial magazine pull-quote: large italic display statement paired with
// a candid square architectural portrait plate and street/project credit.
import Section from "../Section.astro";
import Media from "../Media.astro";
import type { BlockMarker, Tone } from "../../lib/site";

interface Props {
  id?: string;
  tone?: Tone;
  quote: string;
  name: string;
  role?: string;
  image?: string;
  imageAlt?: string;
  index?: number;
  level?: number;
  block?: BlockMarker;
}

const { id, tone, quote, name, role, image, imageAlt, block } = Astro.props;
---

<Section type="testimonial" block={block} id={id} tone={tone}>
  <figure class:list={["testimonial", { "testimonial--with-photo": Boolean(image) }]}>
    {
      image && (
        <div class="testimonial__media">
          <Media src={image} alt={imageAlt ?? name} ratio="1/1" class="testimonial__photo" />
        </div>
      )
    }
    <div class="testimonial__body">
      <span class="testimonial__rule" aria-hidden="true" />
      <blockquote class="testimonial__quote">
        <p>{quote}</p>
      </blockquote>
      <figcaption class="testimonial__by">
        <span class="testimonial__name">{name}</span>
        {role && <span class="testimonial__role">{role}</span>}
      </figcaption>
    </div>
  </figure>
</Section>

<style>
  .testimonial {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .testimonial__body {
    display: grid;
    gap: var(--space-l);
    max-width: 52rem;
  }

  .testimonial__rule {
    inline-size: 3rem;
    block-size: 1px;
    background: var(--tone-link);
  }

  .testimonial__quote {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-style: italic;
    font-weight: var(--weight-display);
    font-optical-sizing: auto;
    line-height: 1.2;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .testimonial__quote p::before {
    content: open-quote;
  }

  .testimonial__quote p::after {
    content: close-quote;
  }

  .testimonial__by {
    display: grid;
    gap: 0.2em;
    padding-block-start: var(--space-m);
    border-block-start: var(--border-width) solid var(--tone-line);
  }

  .testimonial__name {
    font-weight: var(--weight-medium);
    font-size: var(--step-0);
  }

  .testimonial__role {
    font-size: var(--step--2);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--tone-muted);
  }

  .testimonial__media {
    max-width: 18rem;
  }

  @media (min-width: 56rem) {
    .testimonial--with-photo {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: var(--space-2xl);
    }

    .testimonial__media {
      max-width: none;
    }
  }
</style>
