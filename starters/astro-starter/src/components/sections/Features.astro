---
// Architectural ledger grid: numbered rows/columns separated by crisp 1px
// hairlines, delicate line icons and calm typography. 2–4 columns.
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import Icon from "../Icon.astro";
import { withBase, type Link, type BlockMarker, type Tone } from "../../lib/site";

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  heading: string;
  text?: string;
  columns?: number;
  items: Array<{ icon?: string; heading: string; text: string; cta?: Link }>;
  index?: number;
  level?: number;
  block?: BlockMarker;
}

const { id, tone, eyebrow, heading, text, columns = 3, items, index = 0, level = 2, block } = Astro.props;
const headingId = `${id ?? `section-${index}`}-heading`;
const ItemHeading = (level === 1 ? "h2" : "h3") as "h2" | "h3";
---

<Section type="features" block={block} id={id} tone={tone} labelledby={headingId}>
  <SectionHeader eyebrow={eyebrow} heading={heading} text={text} level={level} headingId={headingId} />
  <ul class="features" role="list" data-columns={columns} style={`--columns: ${columns}`}>
    {
      items.map((item, i) => (
        <li class="feature">
          <div class="feature__top">
            <span class="feature__number" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            {item.icon && <Icon name={item.icon} size={16} class="feature__icon" />}
          </div>
          <ItemHeading class="feature__heading">{item.heading}</ItemHeading>
          <p class="feature__text">{item.text}</p>
          {item.cta && (
            <a class="text-link feature__link" href={withBase(item.cta.href)}>
              {item.cta.label}
              <Icon name="arrow-right" size={15} />
            </a>
          )}
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-l) var(--space-l);
    padding: 0;
    list-style: none;
  }

  .feature {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-block-start: var(--space-m);
    border-block-start: var(--border-width) solid var(--tone-line);
  }

  .feature__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    margin-block-end: var(--space-s);
  }

  .feature__number {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-style: italic;
    line-height: 1;
    color: var(--tone-link);
    font-variant-numeric: lining-nums tabular-nums;
  }

  .feature :global(.feature__icon) {
    color: var(--tone-muted);
  }

  .feature__heading {
    font-size: var(--step-2);
    line-height: 1.15;
  }

  .feature__text {
    font-size: var(--step--1);
    line-height: 1.58;
    color: var(--tone-muted);
    max-width: 34em;
  }

  .feature__link {
    margin-block-start: auto;
    padding-block-start: var(--space-xs);
    align-self: flex-start;
  }

  @media (min-width: 60rem) {
    .features {
      grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
      gap: var(--space-xl) 0;
    }

    .feature {
      padding-block: var(--space-m) var(--space-xs);
      padding-inline: var(--space-m);
    }

    .features[data-columns="2"] > .feature:nth-child(2n + 1),
    .features[data-columns="3"] > .feature:nth-child(3n + 1),
    .features[data-columns="4"] > .feature:nth-child(4n + 1) {
      padding-inline-start: 0;
    }

    .features[data-columns="2"] > .feature:not(:nth-child(2n + 1)),
    .features[data-columns="3"] > .feature:not(:nth-child(3n + 1)),
    .features[data-columns="4"] > .feature:not(:nth-child(4n + 1)) {
      border-inline-start: var(--border-width) solid var(--tone-line);
    }

    .features[data-columns="2"] > .feature:nth-child(2n),
    .features[data-columns="3"] > .feature:nth-child(3n),
    .features[data-columns="4"] > .feature:nth-child(4n) {
      padding-inline-end: 0;
    }
  }
</style>
