---
// A blog post teaser: photographic plate, tag & date metadata, title (the link) and summary.
import type { CollectionEntry } from "astro:content";
import Media from "./Media.astro";
import { fill, formatDate, labels, readingMinutes } from "../lib/site";
import { postUrl } from "../lib/posts";

interface Props {
  post: CollectionEntry<"blog">;
  headingLevel?: 2 | 3;
  eager?: boolean;
}

const { post, headingLevel = 3, eager = false } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const minutes = readingMinutes(post.body);
const primaryTag = post.data.tags[0];
---

<article class="post-card">
  <div class="frame post-card__frame">
    <Media src={post.data.image} alt={post.data.imageAlt ?? ""} ratio="16/10" eager={eager} />
  </div>
  <div class="post-card__body">
    <p class="post-card__meta">
      {
        primaryTag && (
          <>
            <span class="post-card__tag">{primaryTag}</span>
            <span aria-hidden="true">·</span>
          </>
        )
      }
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <span aria-hidden="true">·</span>
      <span>{fill(labels.blog.readingTime, { minutes })}</span>
    </p>
    <Heading class="post-card__title">
      <a href={postUrl(post)}>{post.data.title}</a>
    </Heading>
    <p class="post-card__text">{post.data.description}</p>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-m);
  }

  .post-card__body {
    display: grid;
    gap: var(--space-2xs);
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45em;
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--tone-muted);
  }

  .post-card__tag {
    color: var(--tone-link);
  }

  .post-card__title {
    font-size: var(--step-2);
    line-height: 1.14;
  }

  .post-card__title a {
    color: var(--tone-text);
    text-decoration-color: transparent;
  }

  /* The whole card is clickable through the title link. */
  .post-card__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .post-card:hover .post-card__title a {
    text-decoration-color: var(--tone-link);
  }

  .post-card__title a:focus-visible {
    outline: none;
  }

  .post-card:has(a:focus-visible) {
    outline: 2px solid var(--tone-focus);
    outline-offset: 6px;
    border-radius: var(--radius-s);
  }

  .post-card__text {
    margin-block-start: var(--space-3xs);
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--tone-muted);
  }
</style>
