{
  "name": "galley-astro-starter",
  "private": true,
  "version": "1.0.0",
  "description": "An Astro starter for a small studio or business site: pages built from 17 section types, a contact form, a journal with authors and tags, a team, three looks and one-file theming. Every word is in plain files, ready to edit by hand or in a visual page builder.",
  "keywords": [
    "astro",
    "astro-template",
    "astro-theme",
    "starter",
    "template",
    "landing-page",
    "business",
    "blog",
    "page-builder",
    "cms",
    "galley"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "galley": "npx --yes galley-cms",
    "thumbnails": "node scripts/make-thumbnails.mjs",
    "check:type": "node scripts/check-type.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "astro": "^7.4.13",
    "marked": "^18.2.1"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
