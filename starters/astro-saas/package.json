{
  "name": "galley-astro-saas",
  "private": true,
  "version": "1.0.0",
  "description": "An Astro starter for a B2B software company: pages assembled from 29 section types, three working forms, customer stories, a changelog, a blog with tags, a team, three looks and one-file theming. Every word is in plain files, ready to edit by hand or in a visual page builder.",
  "keywords": [
    "astro",
    "astro-template",
    "astro-theme",
    "starter",
    "template",
    "saas",
    "b2b",
    "corporate",
    "landing-page",
    "page-builder",
    "cms"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "galley": "npx --yes galley-cms",
    "thumbnails": "node scripts/make-thumbnails.mjs",
    "check:type": "node scripts/check-type.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "astro": "^7.4.13",
    "marked": "^18.2.1"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
