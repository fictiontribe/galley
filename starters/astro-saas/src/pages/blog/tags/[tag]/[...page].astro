---
// One page per tag: every published post filed under it, newest first,
// `blog.pageSize` (site.json) per page — /blog/tags/planning/, …/2/, …
// Tags are free text on each post; their pages are made from whatever tags
// the posts use, so there is nothing to set up.
import type { GetStaticPaths, Page } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../../../../layouts/Base.astro";
import PostList from "../../../../components/PostList.astro";
import Tags from "../../../../components/Tags.astro";
import Icon from "../../../../components/Icon.astro";
import { postsByTag } from "../../../../lib/posts";
import { fill, labels, site, withBase } from "../../../../lib/site";

export const getStaticPaths = (async ({ paginate }) => {
  // Read with getCollection() here, not the getPosts() helper, so tools that
  // read routes statically (a CMS, for one) can see which collection this
  // page lists. Same filter and order as getPosts().
  const posts = (await getCollection("blog", (post) => import.meta.env.DEV || !post.data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  const tags = postsByTag(posts);
  const names = tags.map((entry) => entry.tag);

  return tags.flatMap((entry) =>
    paginate(entry.posts, { params: { tag: entry.slug }, props: { tag: entry.tag, tags: names }, pageSize: site.blog.pageSize }),
  );
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<"blog">>;
  tag: string;
  tags: string[];
}

const { page: listing, tag, tags } = Astro.props;
const heading = fill(labels.blog.tagTitle, { tag });
const title =
  listing.currentPage > 1 ? `${heading} — ${fill(labels.blog.pageOf, { current: listing.currentPage, total: listing.lastPage })}` : heading;
---

<Base title={title} description={fill(labels.blog.tagDescription, { tag })}>
  <header class="section tone-default tag-header">
    <div class="container">
      <a class="text-link" href={withBase("/blog/")}>
        <Icon name="arrow-left" size={18} />
        {labels.blog.allPosts}
      </a>
      <h1 class="tag-header__title">{heading}</h1>
      <Tags tags={tags} current={tag} label={labels.blog.topics} />
    </div>
  </header>
  <section class="section tone-default tag-list" aria-label={heading}>
    <div class="container">
      <PostList listing={listing} />
    </div>
  </section>
</Base>

<style>
  .tag-header {
    padding-block-end: 0;
  }

  .tag-header .container {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    padding-block-end: var(--space-xl);
    border-block-end: var(--border-width) solid var(--tone-line);
  }

  .tag-header__title {
    font-size: var(--step-5);
    font-weight: var(--weight-display-strong);
    line-height: var(--leading-tight);
    max-width: 16em;
  }

  .tag-list {
    padding-block-start: var(--space-xl);
  }
</style>
