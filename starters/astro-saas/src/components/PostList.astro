---
// One page of a post listing — the blog or a tag — with the pager below it.
// The first post on the first page of the blog is set large.
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import PostCard from "./PostCard.astro";
import Icon from "./Icon.astro";
import { fill, labels } from "../lib/site";

interface Props {
  listing: Page<CollectionEntry<"blog">>;
  /** Set the first post large on the first page. */
  lead?: boolean;
}

const { listing, lead = false } = Astro.props;
---

{
  listing.data.length > 0 ? (
    <ul class="post-list" role="list">
      {listing.data.map((post, i) => {
        const isLead = lead && i === 0 && listing.currentPage === 1;
        return (
          <li class:list={{ "post-list__lead": isLead }}>
            <PostCard post={post} headingLevel={2} eager={i === 0} layout={isLead ? "row" : "card"} />
          </li>
        );
      })}
    </ul>
  ) : (
    <p class="lede">{labels.blog.empty}</p>
  )
}

{
  listing.lastPage > 1 && (
    <nav class="pager" aria-label={labels.blog.pagination}>
      {listing.url.prev ? (
        <a class="text-link" href={listing.url.prev}>
          <Icon name="arrow-left" size={16} />
          {labels.blog.newer}
        </a>
      ) : (
        <span />
      )}
      <span class="pager__status mono">{fill(labels.blog.pageOf, { current: listing.currentPage, total: listing.lastPage })}</span>
      {listing.url.next ? (
        <a class="text-link" href={listing.url.next}>
          {labels.blog.older}
          <Icon name="arrow-right" size={16} />
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}

<style>
  .post-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-l);
    padding: 0;
    list-style: none;
  }

  .post-list > li:not(.post-list__lead) > :global(*) {
    block-size: 100%;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-m);
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-m);
    border-block-start: var(--border-width) solid var(--tone-line);
  }

  .pager > :last-child {
    justify-self: end;
  }

  .pager__status {
    font-size: var(--step--2);
    color: var(--tone-muted);
  }

  @media (min-width: 60rem) {
    .post-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .post-list__lead {
      grid-column: 1 / -1;
      padding: var(--space-l);
      background: var(--tone-surface);
      border: var(--border-width) solid var(--tone-line);
      border-radius: var(--radius-l);
      box-shadow: var(--shadow-card);
    }

    .post-list__lead :global(.post-card__title) {
      font-size: var(--step-3);
      line-height: 1.08;
    }

    .post-list__lead :global(.post-card__text) {
      font-size: var(--step-0);
    }
  }
</style>
