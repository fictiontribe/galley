---
// One cell of a comparison or plan table: "yes", "no" and "partial" become
// a mark with a hidden label (from site.json `labels.table`); anything else
// is shown as written.
import Icon from "./Icon.astro";
import { cellMark, labels } from "../lib/site";

interface Props {
  value: string;
}

const { value } = Astro.props;
const mark = cellMark(value);
const icon = mark === "yes" ? "check" : mark === "partial" ? "half" : "dash";
---

{
  mark ? (
    <span class:list={["mark", `mark--${mark}`]}>
      <Icon name={icon} size={15} />
      <span class="visually-hidden">{labels.table[mark]}</span>
    </span>
  ) : (
    <span class="mark-text">{value}</span>
  )
}

<style>
  .mark {
    display: inline-grid;
    place-items: center;
    inline-size: 1.55rem;
    block-size: 1.55rem;
    border-radius: var(--radius-s);
    border: var(--border-width) solid transparent;
  }

  .mark--yes {
    background: var(--color-positive-soft);
    border-color: color-mix(in oklch, var(--color-positive) 25%, transparent);
    color: var(--color-positive);
  }

  .mark--partial {
    background: var(--color-notice-soft);
    border-color: color-mix(in oklch, var(--color-notice) 25%, transparent);
    color: var(--color-notice);
  }

  .mark--no {
    color: var(--tone-muted);
    opacity: 0.65;
  }

  .mark-text {
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    font-variant-numeric: tabular-nums;
  }
</style>
