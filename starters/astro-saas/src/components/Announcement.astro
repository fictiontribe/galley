---
// The small linked line above a hero heading ("New: offline inspections").
import Icon from "./Icon.astro";
import { withBase, type Link } from "../lib/site";

interface Props {
  link: Link;
}

const { link } = Astro.props;
---

<a class="announcement" href={withBase(link.href)}>
  <span class="announcement__dot" aria-hidden="true"></span>
  <span class="announcement__label">{link.label}</span>
  <Icon name="arrow-right" size={14} />
</a>

<style>
  .announcement {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    justify-self: start;
    padding: 0.32em 0.8em 0.32em 0.6em;
    border: var(--border-width) solid var(--tone-line);
    border-radius: var(--radius-pill);
    background: var(--tone-surface);
    box-shadow: var(--shadow-card);
    color: var(--tone-text);
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
    line-height: 1.3;
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .announcement:hover {
    border-color: var(--tone-control);
    background: var(--tone-raised);
  }

  .announcement__dot {
    flex: none;
    inline-size: 0.45rem;
    block-size: 0.45rem;
    border-radius: 50%;
    background: var(--tone-link);
    box-shadow: 0 0 0 3px var(--tone-mark);
  }

  .announcement :global(svg) {
    flex: none;
    color: var(--tone-link);
    transition: transform var(--duration) var(--ease-out);
  }

  .announcement:hover :global(svg) {
    transform: translateX(0.2em);
  }
</style>
