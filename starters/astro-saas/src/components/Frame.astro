---
// A product screenshot in an app-window frame (or bare). The picture keeps
// its own proportions: pass `ratio` to match the file (16/10 for the
// screenshots in public/images/product/).
import Media from "./Media.astro";

interface Props {
  image: string;
  imageAlt: string;
  ratio?: string;
  frame?: "window" | "bare";
  eager?: boolean;
  class?: string;
}

const { image, imageAlt, ratio = "16/10", frame = "window", eager = false, class: className } = Astro.props;
---

<div class:list={["frame", `frame--${frame}`, className]}>
  {
    frame === "window" && (
      <div class="frame__bar" aria-hidden="true">
        <span class="frame__dots">
          <span />
          <span />
          <span />
        </span>
        <span class="frame__bar-pill">
          <span class="frame__lock" />
          <span class="frame__bar-line" />
        </span>
        <span class="frame__bar-spacer" />
      </div>
    )
  }
  <div class="frame__canvas">
    <Media src={image} alt={imageAlt} ratio={ratio} eager={eager} contain class="frame__media" />
  </div>
</div>

<style>
  .frame {
    position: relative;
    border-radius: var(--radius-l);
  }

  .frame--window {
    padding: 0 0.3rem 0.3rem;
    background: var(--shot-frame);
    border: var(--border-width) solid var(--shot-line);
    box-shadow: var(--shadow-shot);
  }

  .frame--bare {
    box-shadow: var(--shadow-shot);
    border-radius: var(--radius-l);
    overflow: hidden;
  }

  .frame__bar {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) 3.5rem;
    align-items: center;
    gap: var(--space-s);
    block-size: 1.95rem;
    padding-inline: 0.55rem;
  }

  .frame__dots {
    display: flex;
    align-items: center;
    gap: 0.34rem;
  }

  .frame__dots span {
    inline-size: 0.48rem;
    block-size: 0.48rem;
    border-radius: 50%;
    background: var(--shot-faint);
    border: var(--border-width) solid var(--shot-line);
  }

  .frame__bar-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    inline-size: min(100%, 13rem);
    block-size: 1.05rem;
    margin-inline: auto;
    padding-inline: 0.6rem;
    border: var(--border-width) solid var(--shot-line);
    border-radius: var(--radius-s);
    background: var(--shot-panel);
  }

  .frame__lock {
    inline-size: 0.38rem;
    block-size: 0.38rem;
    border-radius: 1px;
    background: var(--shot-ok);
  }

  .frame__bar-line {
    inline-size: 5.5rem;
    block-size: 0.25rem;
    border-radius: var(--radius-pill);
    background: var(--shot-faint);
  }

  .frame__canvas {
    border: var(--border-width) solid var(--shot-line);
    border-radius: calc(var(--radius-l) - 0.25rem);
    overflow: hidden;
    background: var(--shot-bg);
  }

  .frame--bare .frame__canvas {
    border-color: var(--shot-line);
    border-radius: var(--radius-l);
  }

  .frame :global(.frame__media) {
    border-radius: 0;
    background: var(--shot-bg);
  }
</style>
