---
// The brand mark: a signal-coloured tile with two schedule bars and a
// completed tick. Drawn in token colours, so every look recolours it.
interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className } = Astro.props;
---

<svg class:list={["logo", className]} width={size} height={size} viewBox="0 0 28 28" aria-hidden="true" focusable="false">
  <rect class="logo__tile" width="28" height="28" rx="7" />
  <rect class="logo__ink" x="7" y="7" width="14" height="3.2" rx="1.6" />
  <rect class="logo__ink" x="7" y="12.4" width="9" height="3.2" rx="1.6" />
  <rect class="logo__ink" x="7" y="17.8" width="3.2" height="3.2" rx="1.6" />
  <path class="logo__tick" d="m13.6 19.2 2.2 2.2 4.6-4.8" />
</svg>

<style>
  .logo {
    flex: none;
  }

  .logo__tile {
    fill: var(--color-accent);
  }

  .logo__ink {
    fill: var(--color-accent-contrast);
  }

  .logo__tick {
    fill: none;
    stroke: var(--color-accent-contrast);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
