---
// Contact details beside a form. The form is a file in src/content/forms/
// (`form`, default "contact"): its fields, wording, where it sends and its
// thank-you all live there, so it is edited in the form builder or by hand.
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import FormEmbed from "../FormEmbed.astro";
import { withBase, type BlockMarker, type Tone } from "../../lib/site";

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  heading: string;
  text?: string;
  form?: string | { id: string };
  items?: Array<{ label: string; value: string; href?: string }>;
  index?: number;
  level?: number;
  block?: BlockMarker;
}

const { id, tone, eyebrow, heading, text, form = "contact", items = [], index = 0, level = 2, block } = Astro.props;
const key = id ?? `section-${index}`;
const headingId = `${key}-heading`;
---

<Section type="contact" id={id} tone={tone} block={block} labelledby={headingId} grid={level === 1}>
  <div class="contact">
    <div class="contact__info">
      <SectionHeader eyebrow={eyebrow} heading={heading} text={text} level={level} headingId={headingId} size={level === 1 ? "large" : "small"} class="contact__header" />
      {
        items.length > 0 && (
          <dl class="contact__details">
            {items.map((item) => (
              <div>
                <dt class="mono">{item.label}</dt>
                <dd>{item.href ? <a href={withBase(item.href)}>{item.value}</a> : item.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>

    <div class="contact__form card">
      <FormEmbed form={form} />
    </div>
  </div>
</Section>

<style>
  .contact {
    display: grid;
    gap: var(--space-xl);
  }

  .contact__info {
    display: grid;
    gap: var(--space-l);
    align-content: start;
  }

  .contact__info :global(.contact__header) {
    margin-block-end: 0;
  }

  .contact__details {
    display: grid;
    gap: 1px;
    background: var(--tone-line);
    border: var(--border-width) solid var(--tone-line);
    border-radius: var(--radius-l);
    overflow: hidden;
  }

  .contact__details > div {
    display: grid;
    gap: 0.15em;
    padding: var(--space-s) var(--space-m);
    background: var(--tone-surface);
  }

  .contact__details dt {
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--tone-muted);
  }

  .contact__details dd {
    font-size: var(--step-0);
    font-weight: var(--weight-medium);
  }

  .contact__form {
    align-self: start;
    padding: var(--space-l);
    border-block-start: 3px solid var(--tone-link);
    box-shadow: var(--shadow-raised);
  }

  @media (min-width: 60rem) {
    .contact {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-2xl);
    }
  }
</style>
