---
// One capability beside its screenshot. `imageSide` puts the picture left or
// right on wide screens; on phones it follows the text. Alternate the side
// when several run in a row.
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import Actions from "../Actions.astro";
import Checklist from "../Checklist.astro";
import Frame from "../Frame.astro";
import type { BlockMarker, Link, Tone } from "../../lib/site";

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  heading: string;
  text?: string;
  items?: string[];
  image: string;
  imageAlt: string;
  imageSide?: "left" | "right";
  frame?: "window" | "bare";
  cta?: Link;
  secondaryCta?: Link;
  index?: number;
  level?: number;
  block?: BlockMarker;
}

const { id, tone, eyebrow, heading, text, items, image, imageAlt, imageSide = "right", frame = "window", cta, secondaryCta, index = 0, level = 2, block } =
  Astro.props;
const headingId = `${id ?? `section-${index}`}-heading`;
---

<Section type="feature-split" id={id} tone={tone} block={block} labelledby={headingId}>
  <div class:list={["feature-split", `feature-split--image-${imageSide}`]}>
    <div class="feature-split__copy">
      <SectionHeader eyebrow={eyebrow} heading={heading} text={text} level={level} headingId={headingId} size="small" class="feature-split__header" />
      <Checklist items={items} class="feature-split__list" />
      <Actions cta={cta} secondaryCta={secondaryCta} />
    </div>
    <div class="feature-split__media">
      <Frame image={image} imageAlt={imageAlt} frame={frame} eager={index === 0} />
    </div>
  </div>
</Section>

<style>
  .feature-split {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .feature-split__copy {
    display: grid;
    gap: var(--space-l);
    justify-items: start;
  }

  .feature-split__copy :global(.feature-split__header) {
    margin-block-end: 0;
  }

  .feature-split__copy :global(.feature-split__list li) {
    padding-block-end: var(--space-2xs);
    border-block-end: var(--border-width) solid var(--tone-line);
  }

  .feature-split__copy :global(.feature-split__list) {
    gap: var(--space-2xs);
    inline-size: 100%;
  }

  @media (min-width: 60rem) {
    .feature-split {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--space-l);
    }

    .feature-split__copy {
      grid-column: 1 / span 5;
      grid-row: 1;
    }

    .feature-split__media {
      grid-column: 6 / span 7;
      grid-row: 1;
      padding-inline-start: var(--space-l);
    }

    .feature-split--image-left .feature-split__copy {
      grid-column: 8 / span 5;
    }

    .feature-split--image-left .feature-split__media {
      grid-column: 1 / span 7;
      padding-inline: 0 var(--space-l);
    }
  }
</style>
