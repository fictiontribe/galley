---
// Customer or partner logos: an architectural hairline matrix under a hero,
// or a larger grid of tiles. Linked customer logos reveal a subtle corner arrow.
import Section from "../Section.astro";
import Media from "../Media.astro";
import Icon from "../Icon.astro";
import { withBase, type BlockMarker, type Tone } from "../../lib/site";

interface Props {
  id?: string;
  tone?: Tone;
  heading?: string;
  items: Array<{ name: string; image: string; href?: string }>;
  layout?: "row" | "grid";
  index?: number;
  level?: number;
  block?: BlockMarker;
}

const { id, tone, heading, items, layout = "row", index = 0, level = 2, block } = Astro.props;
const headingId = heading ? `${id ?? `section-${index}`}-heading` : undefined;
const Heading = (level === 1 ? "h1" : "h2") as "h1" | "h2";
---

<Section type="logos" id={id} tone={tone} block={block} labelledby={headingId} class="section--compact">
  <div class:list={["logos", `logos--${layout}`]}>
    {heading && <Heading id={headingId} class="logos__heading">{heading}</Heading>}
    <ul class="logos__list" role="list" style={`--count: ${items.length}`}>
      {
        items.map((item) => (
          <li class:list={["logos__item", { "logos__item--linked": Boolean(item.href) }]}>
            {item.href ? (
              <a href={withBase(item.href)} class="logos__link">
                <Media src={item.image} alt={item.name} ratio="3/1" contain />
                <span class="logos__arrow" aria-hidden="true">
                  <Icon name="arrow-up-right" size={14} />
                </span>
              </a>
            ) : (
              <span class="logos__static">
                <Media src={item.image} alt={item.name} ratio="3/1" contain />
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<style>
  .logos {
    display: grid;
    gap: var(--space-s);
  }

  .logos__heading {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    line-height: 1.4;
    color: var(--tone-muted);
  }

  .logos--row {
    text-align: center;
  }

  .logos__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    gap: 1px;
    padding: 0;
    list-style: none;
    background: var(--tone-line);
    border: var(--border-width) solid var(--tone-line);
    border-radius: var(--radius-l);
    overflow: hidden;
  }

  .logos__item {
    position: relative;
    display: flex;
    background: var(--tone-surface);
    color: var(--tone-text);
  }

  .logos__link,
  .logos__static {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 100%;
    padding: var(--space-m) var(--space-s);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .logos__link :global(.media),
  .logos__static :global(.media) {
    max-inline-size: 8.5rem;
    opacity: 0.78;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .logos__arrow {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    color: var(--tone-muted);
    opacity: 0;
    transform: translate(-0.15rem, 0.15rem);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .logos__link:hover {
    background: var(--tone-raised);
  }

  .logos__link:hover :global(.media),
  .logos__link:focus-visible :global(.media) {
    opacity: 1;
  }

  .logos__link:hover .logos__arrow,
  .logos__link:focus-visible .logos__arrow {
    opacity: 1;
    color: var(--tone-link);
    transform: none;
  }

  .logos--grid .logos__heading {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    text-transform: none;
    color: var(--tone-text);
    max-width: 22em;
  }

  .logos--grid .logos__link,
  .logos--grid .logos__static {
    padding: var(--space-l) var(--space-m);
  }

  @media (min-width: 60rem) {
    .logos--row .logos__list {
      grid-template-columns: repeat(var(--count, 6), minmax(0, 1fr));
    }
  }
</style>
