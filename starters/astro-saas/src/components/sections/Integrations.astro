---
// What the product connects to, as hairline tiles grouped by `category` (or one
// grid with the category on each tile). Each tile has an icon or a logo image.
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import Media from "../Media.astro";
import Icon from "../Icon.astro";
import { withBase, type BlockMarker, type Link, type Tone } from "../../lib/site";

interface Item {
  name: string;
  category: string;
  icon?: string;
  image?: string;
  text?: string;
}

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  heading: string;
  text?: string;
  items: Item[];
  layout?: "grouped" | "grid";
  cta?: Link;
  index?: number;
  level?: number;
  block?: BlockMarker;
}

const { id, tone, eyebrow, heading, text, items, layout = "grouped", cta, index = 0, level = 2, block } = Astro.props;
const headingId = `${id ?? `section-${index}`}-heading`;
const GroupHeading = (level === 1 ? "h2" : "h3") as "h2" | "h3";
const groups =
  layout === "grouped"
    ? [...new Set(items.map((item) => item.category))].map((category) => ({ category, items: items.filter((item) => item.category === category) }))
    : [{ category: "", items }];
---

<Section type="integrations" id={id} tone={tone} block={block} labelledby={headingId}>
  <div class="integrations__top">
    <SectionHeader eyebrow={eyebrow} heading={heading} text={text} level={level} headingId={headingId} class="integrations__header" />
    {
      cta && (
        <a class="text-link" href={withBase(cta.href)}>
          {cta.label}
          <Icon name="arrow-right" size={16} />
        </a>
      )
    }
  </div>
  <div class:list={["integrations", `integrations--${layout}`]}>
    {
      groups.map((group) => (
        <div class="integrations__group">
          {group.category && <GroupHeading class="integrations__category mono">{group.category}</GroupHeading>}
          <ul class="integrations__list" role="list">
            {group.items.map((item) => (
              <li class="integration">
                <span class="integration__mark" aria-hidden="true">
                  {item.image ? <Media src={item.image} alt="" ratio="1/1" contain /> : <Icon name={item.icon ?? "plug"} size={18} />}
                </span>
                <span class="integration__body">
                  <span class="integration__name">{item.name}</span>
                  {layout === "grid" && <span class="integration__category mono">{item.category}</span>}
                  {item.text && <span class="integration__text">{item.text}</span>}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .integrations__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-s) var(--space-l);
    margin-block-end: var(--space-xl);
  }

  .integrations__top :global(.integrations__header) {
    margin-block-end: 0;
  }

  .integrations {
    display: grid;
    gap: var(--space-l);
  }

  .integrations--grouped {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-l) var(--space-m);
  }

  .integrations__group {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
  }

  .integrations__category {
    padding-block-end: var(--space-2xs);
    border-block-end: var(--border-width) solid var(--tone-line);
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--tone-muted);
  }

  .integrations__list {
    display: grid;
    gap: 1px;
    padding: 0;
    list-style: none;
    background: var(--tone-line);
    border: var(--border-width) solid var(--tone-line);
    border-radius: var(--radius-l);
    overflow: hidden;
  }

  .integrations--grid .integrations__list {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
  }

  .integration {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-s);
    background: var(--tone-surface);
  }

  .integration__mark {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border: var(--border-width) solid var(--tone-line);
    border-radius: var(--radius-m);
    background: var(--tone-raised);
    color: var(--tone-link);
  }

  .integration__mark :global(.media) {
    inline-size: 1.4rem;
    block-size: 1.4rem;
  }

  .integration__body {
    display: grid;
    gap: 0.1em;
    min-width: 0;
  }

  .integration__name {
    font-size: var(--step--1);
    font-weight: var(--weight-bold);
    line-height: 1.3;
  }

  .integration__category,
  .integration__text {
    font-size: var(--step--2);
    color: var(--tone-muted);
    line-height: 1.38;
  }
</style>
