---
// Two to four figures that prove a claim, with an optional source note.
// `style: cards` puts each figure in a bordered bento cell.
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import type { BlockMarker, Tone } from "../../lib/site";

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  heading?: string;
  text?: string;
  items: Array<{ value: string; label: string; text?: string }>;
  columns?: number;
  style?: "plain" | "cards";
  note?: string;
  index?: number;
  level?: number;
  block?: BlockMarker;
}

const { id, tone, eyebrow, heading, text, items, columns = 4, style = "plain", note, index = 0, level = 2, block } = Astro.props;
const headingId = heading ? `${id ?? `section-${index}`}-heading` : undefined;
---

<Section type="metrics" id={id} tone={tone} block={block} labelledby={headingId}>
  <SectionHeader eyebrow={eyebrow} heading={heading} text={text} level={level} headingId={headingId} />
  <dl class:list={["metrics", `metrics--${style}`]} style={`--columns: ${Math.min(columns, items.length)}`}>
    {
      items.map((item) => (
        <div class="metric">
          <dt class="metric__label">{item.label}</dt>
          <dd class="metric__value">{item.value}</dd>
          {item.text && <dd class="metric__text">{item.text}</dd>}
        </div>
      ))
    }
  </dl>
  {note && <p class="metrics__note">{note}</p>}
</Section>

<style>
  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }

  .metrics--plain {
    gap: 1px;
    background: var(--tone-bg);
    border-block: var(--border-width) solid var(--tone-line);
    overflow: hidden;
  }

  .metrics--cards {
    gap: 1px;
    background: var(--tone-surface);
    border: var(--border-width) solid var(--tone-line);
    border-radius: var(--radius-l);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .metric {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-l) var(--space-m);
    outline: var(--border-width) solid var(--tone-line);
  }

  .metrics--plain .metric {
    background: var(--tone-bg);
  }

  .metrics--plain .metric::before {
    content: "";
    position: absolute;
    top: 0;
    left: var(--space-m);
    inline-size: 2rem;
    block-size: 2px;
    background: var(--tone-link);
  }

  .metrics--cards .metric {
    background: var(--tone-surface);
  }

  /* The figure reads first; the label follows it visually. */
  .metric__value {
    order: -1;
    margin-block-end: var(--space-3xs);
    font-family: var(--font-display);
    font-size: var(--step-5);
    font-weight: var(--weight-display-strong);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .metric__label {
    font-size: var(--step-0);
    font-weight: var(--weight-bold);
    line-height: 1.3;
  }

  .metric__text {
    font-size: var(--step--1);
    color: var(--tone-muted);
    line-height: 1.45;
  }

  .metrics__note {
    margin-block-start: var(--space-m);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--tone-muted);
    max-width: 66em;
  }

  @media (min-width: 60rem) {
    .metrics {
      grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    }

    .metrics--plain .metric:first-child {
      padding-inline-start: 0;
    }

    .metrics--plain .metric:first-child::before {
      left: 0;
    }
  }
</style>
