---
// Several shorter quotes in a grid of two or three columns, as a hairline
// bento matrix or set plainly between hairlines.
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import Media from "../Media.astro";
import type { BlockMarker, Tone } from "../../lib/site";

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  heading?: string;
  text?: string;
  items: Array<{ quote: string; name: string; role?: string; company?: string; image?: string }>;
  columns?: number;
  style?: "cards" | "plain";
  index?: number;
  level?: number;
  block?: BlockMarker;
}

const { id, tone, eyebrow, heading, text, items, columns = 3, style = "cards", index = 0, level = 2, block } = Astro.props;
const headingId = heading ? `${id ?? `section-${index}`}-heading` : undefined;
---

<Section type="testimonials" id={id} tone={tone} block={block} labelledby={headingId}>
  <SectionHeader eyebrow={eyebrow} heading={heading} text={text} level={level} headingId={headingId} />
  <ul class:list={["quotes", `quotes--${style}`]} role="list" style={`--columns: ${Math.min(columns, items.length)}`}>
    {
      items.map((item) => (
        <li>
          <figure class="quote">
            <blockquote class="quote__text">
              <p>{item.quote}</p>
            </blockquote>
            <figcaption class="quote__by">
              {item.image && <Media src={item.image} alt="" ratio="1/1" class="quote__photo" />}
              <span>
                <span class="quote__name">{item.name}</span>
                {(item.role || item.company) && <span class="quote__role">{[item.role, item.company].filter(Boolean).join(", ")}</span>}
              </span>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    padding: 0;
    list-style: none;
  }

  .quotes--cards {
    gap: 1px;
    background: var(--tone-surface);
    border: var(--border-width) solid var(--tone-line);
    border-radius: var(--radius-l);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .quotes--plain {
    gap: var(--space-l);
  }

  .quote {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-l);
    block-size: 100%;
  }

  .quotes--cards .quote {
    padding: var(--space-l);
    background: var(--tone-surface);
    outline: var(--border-width) solid var(--tone-line);
  }

  .quotes--plain .quote {
    padding-block-start: var(--space-m);
    border-block-start: var(--border-width) solid var(--tone-line);
  }

  .quote__text {
    font-size: var(--step-0);
    line-height: 1.55;
    color: var(--tone-text);
  }

  .quote__text p::before {
    content: "“";
    color: var(--tone-link);
    font-weight: var(--weight-bold);
    margin-inline-end: 0.05em;
  }

  .quote__text p::after {
    content: "”";
    color: var(--tone-link);
    font-weight: var(--weight-bold);
    margin-inline-start: 0.05em;
  }

  .quote__by {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding-block-start: var(--space-s);
    border-block-start: var(--border-width) solid var(--tone-line);
  }

  .quote__by :global(.quote__photo) {
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: 50%;
    border: var(--border-width) solid var(--tone-line);
  }

  .quote__name {
    display: block;
    font-size: var(--step--1);
    font-weight: var(--weight-bold);
    line-height: 1.25;
  }

  .quote__role {
    display: block;
    font-size: var(--step--2);
    color: var(--tone-muted);
  }

  @media (min-width: 60rem) {
    .quotes {
      grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    }
  }
</style>
