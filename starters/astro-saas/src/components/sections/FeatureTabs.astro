---
// Several product areas, one shown at a time. Without JavaScript every panel
// is shown in turn, each under its own heading; a few lines of script turn
// the labels into tabs (arrow keys move between them). `layout: vertical`
// lists the tabs beside the panel on wide screens.
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import Checklist from "../Checklist.astro";
import Frame from "../Frame.astro";
import Icon from "../Icon.astro";
import { labels, withBase, type BlockMarker, type Link, type Tone } from "../../lib/site";

interface Tab {
  label: string;
  heading: string;
  text: string;
  items?: string[];
  image: string;
  imageAlt: string;
  cta?: Link;
}

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  heading: string;
  text?: string;
  items: Tab[];
  layout?: "horizontal" | "vertical";
  frame?: "window" | "bare";
  index?: number;
  level?: number;
  block?: BlockMarker;
}

const { id, tone, eyebrow, heading, text, items, layout = "horizontal", frame = "window", index = 0, level = 2, block } = Astro.props;
const key = id ?? `section-${index}`;
const headingId = `${key}-heading`;
const PanelHeading = (level === 1 ? "h2" : "h3") as "h2" | "h3";
---

<Section type="feature-tabs" id={id} tone={tone} block={block} labelledby={headingId}>
  <SectionHeader eyebrow={eyebrow} heading={heading} text={text} level={level} headingId={headingId} align={layout === "horizontal" ? "center" : "left"} />
  <div class:list={["tabs", `tabs--${layout}`]} data-tabs>
    <div class="tabs__list" role="tablist" aria-label={labels.tabs.list} hidden data-tabs-list>
      {
        items.map((item, i) => (
          <button class="tabs__tab" type="button" role="tab" id={`${key}-tab-${i}`} aria-controls={`${key}-panel-${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
            <span class="tabs__index mono">{String(i + 1).padStart(2, "0")}</span>
            <span class="tabs__label">{item.label}</span>
          </button>
        ))
      }
    </div>
    <div class="tabs__panels">
      {
        items.map((item, i) => (
          <div class="tabs__panel" id={`${key}-panel-${i}`} data-tabs-panel>
            <div class="tabs__copy">
              <p class="eyebrow tabs__eyebrow">{item.label}</p>
              <PanelHeading class="tabs__heading">{item.heading}</PanelHeading>
              <p class="tabs__text">{item.text}</p>
              <Checklist items={item.items} class="tabs__checklist" />
              {item.cta && (
                <a class="text-link" href={withBase(item.cta.href)}>
                  {item.cta.label}
                  <Icon name="arrow-right" size={16} />
                </a>
              )}
            </div>
            <div class="tabs__stage">
              <Frame image={item.image} imageAlt={item.imageAlt} frame={frame} class="tabs__media" />
            </div>
          </div>
        ))
      }
    </div>
  </div>
  <script is:inline>
    // Progressive enhancement: turn this section's stacked panels into tabs.
    (() => {
      const root = document.currentScript?.parentElement?.querySelector("[data-tabs]:not([data-tabs-ready])");
      if (!root) return;
      root.setAttribute("data-tabs-ready", "");
      const list = root.querySelector("[data-tabs-list]");
      const tabs = [...list.querySelectorAll("[role=tab]")];
      const panels = [...root.querySelectorAll("[data-tabs-panel]")];
      panels.forEach((panel, i) => {
        panel.setAttribute("role", "tabpanel");
        panel.setAttribute("aria-labelledby", tabs[i].id);
        panel.setAttribute("tabindex", "0");
        panel.hidden = i !== 0;
      });
      list.hidden = false;
      const select = (next, focus) => {
        tabs.forEach((tab, i) => {
          const on = i === next;
          tab.setAttribute("aria-selected", String(on));
          tab.tabIndex = on ? 0 : -1;
          panels[i].hidden = !on;
        });
        if (focus) tabs[next].focus();
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => select(i, false));
        tab.addEventListener("keydown", (event) => {
          const last = tabs.length - 1;
          const moves = { ArrowRight: i + 1, ArrowDown: i + 1, ArrowLeft: i - 1, ArrowUp: i - 1, Home: 0, End: last };
          if (!(event.key in moves)) return;
          event.preventDefault();
          let next = moves[event.key];
          if (next > last) next = 0;
          if (next < 0) next = last;
          select(next, true);
        });
      });
    })();
  </script>
</Section>

<style>
  .tabs {
    display: grid;
    gap: var(--space-m);
  }

  .tabs__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(max-content, 1fr);
    gap: 1px;
    overflow-x: auto;
    scrollbar-width: none;
    background: var(--tone-line);
    border: var(--border-width) solid var(--tone-line);
    border-radius: var(--radius-l);
    overflow: hidden;
  }

  .tabs__list[hidden] {
    display: none;
  }

  .tabs--horizontal .tabs__list {
    inline-size: min(100%, 44rem);
    justify-self: center;
  }

  .tabs__tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    min-height: 3rem;
    padding: 0.65em 1.15em;
    border: 0;
    background: var(--tone-surface);
    color: var(--tone-muted);
    font-size: var(--step--1);
    font-weight: var(--weight-bold);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .tabs__tab:hover {
    background: var(--tone-raised);
    color: var(--tone-text);
  }

  .tabs__tab[aria-selected="true"] {
    background: var(--tone-text);
    color: var(--tone-bg);
  }

  .tabs__index {
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
  }

  .tabs__tab[aria-selected="true"] .tabs__index {
    color: var(--tone-bg);
  }

  .tabs__panels {
    display: grid;
    gap: var(--space-xl);
  }

  .tabs__panel {
    display: grid;
    gap: var(--space-l);
    align-items: center;
    padding: var(--space-l);
    background: var(--tone-surface);
    border: var(--border-width) solid var(--tone-line);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-card);
  }

  .tabs__panel[hidden] {
    display: none;
  }

  .tabs__panel:focus-visible {
    outline-offset: 4px;
  }

  .tabs__copy {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
  }

  .tabs__heading {
    font-size: var(--step-3);
    line-height: 1.08;
  }

  .tabs__text {
    color: var(--tone-muted);
    font-size: var(--step-0);
    line-height: 1.55;
  }

  .tabs__copy :global(.tabs__checklist) {
    inline-size: 100%;
    margin-block-start: var(--space-2xs);
    padding-block-start: var(--space-s);
    border-block-start: var(--border-width) solid var(--tone-line);
    font-size: var(--step--1);
  }

  /* Once the tabs are live, the tab already names the panel. */
  [data-tabs-ready] .tabs__eyebrow {
    display: none;
  }

  @media (min-width: 60rem) {
    .tabs__panel {
      grid-template-columns: minmax(0, 4.5fr) minmax(0, 7.5fr);
      gap: var(--space-xl);
      padding: var(--space-xl);
    }

    .tabs--vertical[data-tabs-ready] {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      gap: var(--space-l);
      align-items: start;
    }

    .tabs--vertical .tabs__list {
      grid-auto-flow: row;
      position: sticky;
      top: calc(var(--header-height) + var(--space-m));
    }

    .tabs--vertical .tabs__tab {
      justify-content: flex-start;
    }

    .tabs--vertical[data-tabs-ready] .tabs__panel {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
  }
</style>
