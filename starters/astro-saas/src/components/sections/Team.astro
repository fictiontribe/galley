---
// People from the team collection (src/content/team/). List `members` by file
// name to choose who appears and in what order; leave it out to show
// everyone, sorted by their `order`. `style: compact` sets small round
// portraits beside the names.
import { getCollection, getEntries } from "astro:content";
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import Media from "../Media.astro";
import { withBase, type BlockMarker, type Tone } from "../../lib/site";
import { referenceId } from "../../lib/customers";

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  heading: string;
  text?: string;
  members?: Array<string | { collection: "team"; id: string }>;
  columns?: number;
  style?: "portrait" | "compact";
  index?: number;
  level?: number;
  block?: BlockMarker;
}

const { id, tone, eyebrow, heading, text, members, columns = 3, style = "portrait", index = 0, level = 2, block } = Astro.props;
const headingId = `${id ?? `section-${index}`}-heading`;
const ItemHeading = (level === 1 ? "h2" : "h3") as "h2" | "h3";

const people = members?.length
  ? (await getEntries(members.map((member) => ({ collection: "team" as const, id: referenceId(member) })))).filter(Boolean)
  : (await getCollection("team")).sort((a, b) => a.data.order - b.data.order);
---

<Section type="team" id={id} tone={tone} block={block} labelledby={headingId}>
  <SectionHeader eyebrow={eyebrow} heading={heading} text={text} level={level} headingId={headingId} />
  <ul class:list={["team", `team--${style}`]} role="list" style={`--columns: ${Math.min(columns, people.length)}`}>
    {
      people.map((person) => (
        <li class="person">
          <Media src={person.data.photo} alt={person.data.name} ratio={style === "compact" ? "1/1" : "4/5"} class="person__photo" />
          <div class="person__body">
            <ItemHeading class="person__name">{person.data.name}</ItemHeading>
            <p class="person__role mono">{person.data.role}</p>
            {style === "portrait" && <p class="person__bio">{person.data.bio}</p>}
            {person.data.links.length > 0 && (
              <ul class="person__links" role="list">
                {person.data.links.map((link) => (
                  <li>
                    <a href={withBase(link.href)}>{link.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .team {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    padding: 0;
    list-style: none;
  }

  .team--portrait {
    gap: 1px;
    background: var(--tone-surface);
    border: var(--border-width) solid var(--tone-line);
    border-radius: var(--radius-l);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .person {
    display: grid;
    align-content: start;
    gap: var(--space-s);
  }

  .team--portrait .person {
    padding: var(--space-m);
    background: var(--tone-surface);
    outline: var(--border-width) solid var(--tone-line);
  }

  .person :global(.person__photo) {
    border: var(--border-width) solid var(--tone-line);
  }

  .person__body {
    display: grid;
    gap: var(--space-3xs);
  }

  .person__name {
    font-size: var(--step-1);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .person__role {
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
    color: var(--tone-link);
  }

  .person__bio {
    margin-block-start: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--tone-muted);
    line-height: 1.5;
  }

  .person__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    margin-block-start: var(--space-2xs);
    padding: 0;
    list-style: none;
    font-size: var(--step--2);
  }

  .team--compact {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 1px;
    background: var(--tone-surface);
    border: var(--border-width) solid var(--tone-line);
    border-radius: var(--radius-l);
    overflow: hidden;
  }

  .team--compact .person {
    grid-template-columns: 3.5rem 1fr;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-m);
    background: var(--tone-surface);
    outline: var(--border-width) solid var(--tone-line);
  }

  .team--compact :global(.person__photo) {
    border-radius: 50%;
  }

  @media (min-width: 64rem) {
    .team {
      grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    }
  }
</style>
