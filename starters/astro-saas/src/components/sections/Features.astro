---
// A grid of short points: icon, heading, text and an optional link. Two to
// four columns, plain (between hairlines) or as an architectural bento grid.
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import Icon from "../Icon.astro";
import { withBase, type BlockMarker, type Link, type Tone } from "../../lib/site";

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  heading: string;
  text?: string;
  items: Array<{ icon?: string; heading: string; text: string; cta?: Link }>;
  columns?: number;
  style?: "plain" | "cards";
  align?: "left" | "center";
  index?: number;
  level?: number;
  block?: BlockMarker;
}

const { id, tone, eyebrow, heading, text, items, columns = 3, style = "plain", align = "left", index = 0, level = 2, block } = Astro.props;
const headingId = `${id ?? `section-${index}`}-heading`;
const ItemHeading = (level === 1 ? "h2" : "h3") as "h2" | "h3";
---

<Section type="features" id={id} tone={tone} block={block} labelledby={headingId}>
  <SectionHeader eyebrow={eyebrow} heading={heading} text={text} level={level} headingId={headingId} align={align} />
  <ul class:list={["features", `features--${style}`]} role="list" style={`--columns: ${Math.min(columns, items.length)}`}>
    {
      items.map((item, i) => (
        <li class="feature">
          <div class="feature__top">
            <span class="feature__icon" aria-hidden="true">
              {item.icon ? <Icon name={item.icon} size={18} /> : <span class="feature__number">{String(i + 1).padStart(2, "0")}</span>}
            </span>
            <span class="feature__index mono" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
          </div>
          <ItemHeading class="feature__heading">{item.heading}</ItemHeading>
          <p class="feature__text">{item.text}</p>
          {item.cta && (
            <a class="text-link feature__link" href={withBase(item.cta.href)}>
              {item.cta.label}
              <Icon name="arrow-right" size={16} />
            </a>
          )}
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    padding: 0;
    list-style: none;
  }

  .features--plain {
    gap: var(--space-xl) var(--space-l);
  }

  .features--cards {
    gap: 1px;
    background: var(--tone-surface);
    border: var(--border-width) solid var(--tone-line);
    border-radius: var(--radius-l);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .feature {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
  }

  .features--plain .feature {
    padding-block-start: var(--space-m);
    border-block-start: var(--border-width) solid var(--tone-line);
  }

  .features--cards .feature {
    padding: var(--space-l);
    background: var(--tone-surface);
    outline: var(--border-width) solid var(--tone-line);
  }

  .feature__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-end: var(--space-xs);
  }

  .feature__icon {
    display: inline-grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border: var(--border-width) solid var(--tone-line);
    border-radius: var(--radius-m);
    background: var(--tone-raised);
    color: var(--tone-link);
  }

  .feature__index {
    font-size: var(--step--2);
    color: var(--tone-muted);
  }

  .feature__number {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
  }

  .feature__heading {
    font-size: var(--step-1);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .feature__text {
    font-size: var(--step--1);
    color: var(--tone-muted);
    max-width: 34em;
    line-height: 1.55;
  }

  .feature__link {
    margin-block-start: var(--space-2xs);
    justify-self: start;
  }

  @media (min-width: 60rem) {
    .features {
      grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    }
  }
</style>
