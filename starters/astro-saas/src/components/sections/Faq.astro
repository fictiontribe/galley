---
// Questions and answers as native <details>. Answers accept markdown.
// `layout: split` keeps the heading beside the questions on wide screens.
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import Icon from "../Icon.astro";
import { markdown, withBase, type BlockMarker, type Link, type Tone } from "../../lib/site";

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  heading: string;
  text?: string;
  items: Array<{ question: string; answer: string }>;
  layout?: "split" | "stacked";
  cta?: Link;
  index?: number;
  level?: number;
  block?: BlockMarker;
}

const { id, tone, eyebrow, heading, text, items, layout = "split", cta, index = 0, level = 2, block } = Astro.props;
const headingId = `${id ?? `section-${index}`}-heading`;
---

<Section type="faq" id={id} tone={tone} block={block} labelledby={headingId}>
  <div class:list={["faq", `faq--${layout}`]}>
    <div class="faq__head">
      <SectionHeader eyebrow={eyebrow} heading={heading} text={text} level={level} headingId={headingId} size="small" align={layout === "stacked" ? "center" : "left"} class="faq__header" />
      {
        cta && (
          <a class="text-link" href={withBase(cta.href)}>
            {cta.label}
            <Icon name="arrow-right" size={16} />
          </a>
        )
      }
    </div>
    <div class="faq__list">
      {
        items.map((item, i) => (
          <details class="faq__item">
            <summary class="faq__question">
              <span class="faq__index mono" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="faq__q-text">{item.question}</span>
              <span class="faq__icon-box" aria-hidden="true">
                <Icon name="plus" size={16} class="faq__icon" />
              </span>
            </summary>
            <div class="faq__answer prose" set:html={markdown(item.answer)} />
          </details>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .faq {
    display: grid;
    gap: var(--space-l);
  }

  .faq__head {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }

  .faq--stacked .faq__head {
    justify-items: center;
  }

  .faq__head :global(.faq__header) {
    margin-block-end: 0;
  }

  .faq--stacked .faq__list {
    inline-size: 100%;
    max-width: 52rem;
    margin-inline: auto;
  }

  .faq__list {
    background: var(--tone-surface);
    border: var(--border-width) solid var(--tone-line);
    border-radius: var(--radius-l);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .faq__item + .faq__item {
    border-block-start: var(--border-width) solid var(--tone-line);
  }

  .faq__question {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-m) var(--space-l);
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: var(--weight-bold);
    letter-spacing: -0.015em;
    line-height: 1.35;
    list-style: none;
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:hover {
    background: var(--tone-raised);
  }

  .faq__index {
    font-size: var(--step--2);
    color: var(--tone-muted);
  }

  .faq__icon-box {
    display: inline-grid;
    place-items: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    border: var(--border-width) solid var(--tone-line);
    border-radius: var(--radius-s);
    background: var(--tone-raised);
    color: var(--tone-link);
  }

  .faq__question :global(.faq__icon) {
    transition: transform var(--duration) var(--ease-out);
  }

  .faq__item[open] :global(.faq__icon) {
    transform: rotate(45deg);
  }

  .faq__answer {
    padding: 0 var(--space-l) var(--space-m) calc(var(--space-l) + 2.3rem);
    font-size: var(--step--1);
    color: var(--tone-muted);
  }

  @media (min-width: 60rem) {
    .faq--split {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-2xl);
      align-items: start;
    }

    .faq--split .faq__head {
      position: sticky;
      top: calc(var(--header-height) + var(--space-l));
    }
  }
</style>
