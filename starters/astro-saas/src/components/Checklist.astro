---
// A short list of proof points with check marks ("No card needed").
import Icon from "./Icon.astro";

interface Props {
  items?: string[];
  /** Run the points along one line (wrapping) instead of stacking them. */
  inline?: boolean;
  class?: string;
}

const { items = [], inline = false, class: className } = Astro.props;
---

{
  items.length > 0 && (
    <ul class:list={["checklist", { "checklist--inline": inline }, className]} role="list">
      {items.map((item) => (
        <li>
          <span class="checklist__mark" aria-hidden="true">
            <Icon name="check" size={14} />
          </span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  )
}

<style>
  .checklist {
    display: grid;
    gap: var(--space-2xs);
    padding: 0;
    list-style: none;
  }

  .checklist--inline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    padding-block-start: var(--space-s);
    border-block-start: var(--border-width) solid var(--tone-line);
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
    color: var(--tone-muted);
  }

  .checklist li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.55em;
  }

  .checklist__mark {
    display: inline-grid;
    place-items: center;
    inline-size: 1.2rem;
    block-size: 1.2rem;
    margin-block-start: 0.16em;
    border: var(--border-width) solid color-mix(in oklch, var(--tone-link) 28%, var(--tone-line));
    border-radius: var(--radius-s);
    background: var(--tone-mark);
    color: var(--tone-link);
  }

  .checklist--inline .checklist__mark {
    inline-size: 1.05rem;
    block-size: 1.05rem;
    margin-block-start: 0.1em;
  }
</style>
