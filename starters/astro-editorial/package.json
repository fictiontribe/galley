{
  "name": "galley-astro-editorial",
  "private": true,
  "version": "1.0.0",
  "description": "A photography-led Astro starter for a fashion label: a campaign home page, lookbooks, a journal with tags, stockists and an atelier page, built from 20 image-first section types, with three looks, real photographs and the shoot brief they were made from, and forms that send to the Galley inbox. Every word is in plain files, ready to edit by hand or with Galley.",
  "keywords": [
    "astro",
    "astro-template",
    "astro-theme",
    "starter",
    "template",
    "fashion",
    "editorial",
    "portfolio",
    "lookbook",
    "photography",
    "blog",
    "cms",
    "galley"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "galley": "npx --yes galley-cms",
    "placeholders": "node scripts/make-placeholders.mjs",
    "photos": "node scripts/ingest-photos.mjs",
    "thumbnails": "node scripts/make-thumbnails.mjs",
    "check:type": "node scripts/check-type.mjs"
  },
  "dependencies": {
    "@fontsource-variable/albert-sans": "^5.3.0",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "astro": "^7.4.13",
    "marked": "^18.2.1"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
