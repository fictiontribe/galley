---
// The main button and its quieter partner (an underlined label).
import Icon from "./Icon.astro";
import { isExternal, withBase, type Link } from "../lib/site";

interface Props {
  cta?: Link;
  secondaryCta?: Link;
  class?: string;
}

const { cta, secondaryCta, class: className } = Astro.props;
---

{
  (cta || secondaryCta) && (
    <div class:list={["actions", className]}>
      {cta && (
        <a class="button" href={withBase(cta.href)}>
          {cta.label}
          <Icon name={isExternal(cta.href) ? "arrow-up-right" : "arrow-right"} size={16} />
        </a>
      )}
      {secondaryCta && (
        <a class="text-link" href={withBase(secondaryCta.href)}>
          {secondaryCta.label}
        </a>
      )}
    </div>
  )
}
