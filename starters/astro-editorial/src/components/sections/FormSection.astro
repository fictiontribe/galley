---
// Any form from src/content/forms/, with a heading and an optional
// photograph beside it: a stockist enquiry, a fitting request. The form's
// fields, wording and destination are its own file; the site kit renders it.
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import Media from "../Media.astro";
import { Form } from "../../galley/components/index.js";
import { labels, type Tone } from "../../lib/site";

interface Props {
  id?: string;
  tone?: Tone;
  eyebrow?: string;
  heading: string;
  text?: string;
  form: string | { id: string };
  image?: string;
  imageAlt?: string;
  index?: number;
  level?: number;
  block?: { key: string; type: string };
}

const { id, tone, eyebrow, heading, text, form, image, imageAlt = "", index = 0, level = 2, block } = Astro.props;
const headingId = `${id ?? `section-${index}`}-heading`;
const formId = (typeof form === "string" ? form : form?.id) ?? "";
// A section just added on the page names no form yet: it shows a note while
// developing, so the preview keeps drawing; a production build stops with the reason.
if (!formId && !import.meta.env.DEV) throw new Error("A form section has no form chosen: set its `form` to a file name in src/content/forms/.");
---

<Section type="form" id={id} tone={tone} labelledby={headingId} block={block}>
  <div class:list={["form-section", { "form-section--image": image }]}>
    <div class="form-section__copy">
      <SectionHeader eyebrow={eyebrow} heading={heading} text={text} level={level} headingId={headingId} class="form-section__header" />
      {formId ? <Form id={formId} submitClass="button" /> : <p class="form-section__missing" role="note">{labels.dev.chooseForm}</p>}
    </div>
    {
      image && (
        <div class="form-section__figure frame">
          <Media src={image} alt={imageAlt} ratio="portrait" class="media--capped" />
        </div>
      )
    }
  </div>
</Section>

<style>
  .form-section {
    display: grid;
    gap: var(--space-l) var(--gutter);
    align-items: start;
  }

  .form-section__copy {
    display: grid;
    gap: var(--space-l);
    align-content: start;
    max-inline-size: 40rem;
  }

  .form-section__copy :global(.form-section__header) {
    margin-block-end: 0;
  }

  @media (min-width: 56rem) {
    .form-section {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .form-section__copy {
      grid-column: 1 / span 6;
      grid-row: 1;
    }

    .form-section__figure {
      grid-column: 7 / -1;
      grid-row: 1;
      position: sticky;
      inset-block-start: var(--space-l);
    }
  }
</style>
