---
// A journal story teaser: cover, date, title (the link) and description.
import Media from "./Media.astro";
import { fill, formatDate, labels, readingMinutes } from "../lib/site";
import { postUrl, type Post } from "../lib/journal";

interface Props {
  post: Post;
  headingLevel?: 2 | 3;
  eager?: boolean;
}

const { post, headingLevel = 3, eager = false } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const minutes = readingMinutes(post.body);
---

<article class="post-card">
  <div class="frame">
    <Media src={post.data.image} alt={post.data.imageAlt ?? ""} ratio="landscape" eager={eager} />
  </div>
  <div class="post-card__body">
    <p class="label post-card__meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <span aria-hidden="true">/</span>
      <span>{fill(labels.journal.readingTime, { minutes })}</span>
    </p>
    <Heading class="post-card__title">
      <a href={postUrl(post)}>{post.data.title}</a>
    </Heading>
    <p class="post-card__text">{post.data.description}</p>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-s);
  }

  .post-card__body {
    display: grid;
    gap: var(--space-2xs);
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
  }

  .post-card {
    transition: transform var(--duration) var(--ease-out);
  }

  .post-card:hover {
    transform: translateY(-2px);
  }

  .post-card__title a {
    color: var(--tone-text);
    text-decoration-color: transparent;
  }

  /* The whole card is clickable through the title link. */
  .post-card__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .post-card:hover .post-card__title a {
    text-decoration-color: currentColor;
  }

  @media (hover: hover) {
    .post-card:hover :global(.media) {
      transform: scale(1.025);
    }
  }

  /* On a phone a story is a row: a small cover beside its date and title. */
  @media (max-width: 39.99rem) {
    .post-card {
      grid-template-columns: 10rem minmax(0, 1fr);
      align-items: start;
    }

    .post-card__text {
      display: none;
    }
  }

  .post-card__text {
    font-size: var(--step--1);
    color: var(--tone-muted);
    max-inline-size: 34em;
  }
</style>
