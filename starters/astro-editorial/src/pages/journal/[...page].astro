---
// The journal index: the sections of src/content/pages/journal.md, the
// topics (tags) in use, then every published story, `journal.pageSize`
// (site.json) per page — /journal/, /journal/2/, …
import type { GetStaticPaths, Page } from "astro";
import { getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageEntry from "../../components/PageEntry.astro";
import PostList from "../../components/PostList.astro";
import Tags from "../../components/Tags.astro";
import { getPosts, postsByTag, type Post } from "../../lib/journal";
import { fill, labels, site } from "../../lib/site";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  const tags = postsByTag(posts).map((entry) => entry.tag);
  return paginate(posts, { pageSize: site.journal.pageSize, props: { tags } });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
  tags: string[];
}

const { page: listing, tags } = Astro.props;
const entry = await getEntry("pages", "journal");
if (!entry) throw new Error("src/content/pages/journal.md is missing.");
const title =
  listing.currentPage > 1
    ? `${entry.data.title} — ${fill(labels.journal.pageOf, { current: listing.currentPage, total: listing.lastPage })}`
    : entry.data.title;
---

<Base
  title={title}
  description={entry.data.description}
  image={entry.data.image}
  noindex={entry.data.noindex}
  overlayHeader={entry.data.sections[0]?.type === "campaign-hero"}
>
  <PageEntry page={entry}>
    <section class="section section--free tone-default journal-index" aria-label={labels.journal.allPosts}>
      <div class="container">
        <Tags tags={tags} label={labels.journal.topics} class="journal-index__topics" />
        <PostList listing={listing} lead />
      </div>
    </section>
  </PageEntry>
</Base>

<style>
  .journal-index {
    padding-block-start: 0;
  }

  .journal-index :global(.journal-index__topics) {
    margin-block-end: var(--space-xl);
  }
</style>
