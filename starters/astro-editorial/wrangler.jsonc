// Cloudflare Workers, static assets only: what the README's "Deploy to
// Cloudflare" button (and `npx wrangler deploy` after `npm run build`)
// publishes. Other hosts ignore this file; delete it if you don't use Cloudflare.
{
  "name": "galley-astro-editorial",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
