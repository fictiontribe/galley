{
  "name": "galley-plugin-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A worked Galley plugin: a script integration, a publish webhook and a word-count tool for the assistant. The template to copy.",
  "keywords": [
    "galley",
    "galley-plugin"
  ],
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@galley/plugin-kit": "workspace:*"
  }
}
