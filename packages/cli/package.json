{
  "name": "galley-cms",
  "version": "0.3.0",
  "type": "module",
  "description": "Galley, the open-source AI CMS for static sites: change a page, check it in Proof, publish it to your own git repository. Run `npx galley-cms` in a site's folder.",
  "keywords": [
    "cms",
    "ai-cms",
    "headless-cms",
    "git-cms",
    "static-site",
    "astro",
    "visual-editor",
    "mcp"
  ],
  "license": "Apache-2.0",
  "author": "Fiction Tribe (https://fictiontribe.com)",
  "homepage": "https://galley.fictiontribe.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fictiontribe/galley.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/fictiontribe/galley/issues",
  "bin": {
    "galley": "bin/galley.js",
    "galley-cms": "bin/galley.js"
  },
  "files": [
    "bin/galley.js",
    "dist"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs --release",
    "postpack": "node build.mjs --clean",
    "verify-pack": "node scripts/verify-pack.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@galley/core": "workspace:*",
    "@galley/mcp": "workspace:*",
    "@galley/server": "workspace:*",
    "esbuild": "^0.28.0"
  }
}
