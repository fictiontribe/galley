	<item>
		<title><![CDATA[Glaze notes: three recipes we keep coming back to]]></title>
		<link>https://old.example.org/2024/03/glaze-notes/</link>
		<pubDate>Tue, 05 Mar 2024 10:00:00 +0000</pubDate>
		<dc:creator><![CDATA[sam]]></dc:creator>
		<guid isPermaLink="false">https://old.example.org/?p=102</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:paragraph -->
<p>Three glazes do most of the work in this studio.</p>
<!-- /wp:paragraph -->

<!-- wp:heading -->
<h2 class="wp-block-heading">The recipes</h2>
<!-- /wp:heading -->

<!-- wp:list {"ordered":true} -->
<ol><li>Celadon<ul><li>Pools in carved lines</li></ul></li><li>Tenmoku</li></ol>
<!-- /wp:list -->

<!-- wp:table -->
<figure class="wp-block-table"><table><thead><tr><th>Glaze</th><th>Cone</th></tr></thead><tbody><tr><td>Celadon</td><td>10</td></tr><tr><td>Tenmoku</td><td>10</td></tr></tbody></table></figure>
<!-- /wp:table -->

<!-- wp:code -->
<pre class="wp-block-code"><code class="language-python">cone = 10</code></pre>
<!-- /wp:code -->

<!-- wp:image {"id":205} -->
<figure class="wp-block-image size-large"><img src="https://old.example.org/wp-content/uploads/2024/04/throwing-1024x683.png" alt="Hands on a wheel" class="wp-image-205"/><figcaption class="wp-element-caption">Throwing a test bowl</figcaption></figure>
<!-- /wp:image -->

<!-- wp:gallery {"linkTo":"none"} -->
<figure class="wp-block-gallery has-nested-images columns-default"><!-- wp:image {"id":203} -->
<figure class="wp-block-image"><img src="https://old.example.org/wp-content/uploads/2024/04/bowl-768x512.png" alt="A speckled bowl" class="wp-image-203"/></figure>
<!-- /wp:image -->
<!-- wp:image {"id":204} -->
<figure class="wp-block-image"><img src="https://old.example.org/wp-content/uploads/2024/04/mugs-768x512.png" alt="Four mugs in a row" class="wp-image-204"/></figure>
<!-- /wp:image --></figure>
<!-- /wp:gallery -->

<!-- wp:quote -->
<blockquote class="wp-block-quote"><p>Write every recipe down, even the failures.</p><cite>Sam Okoro</cite></blockquote>
<!-- /wp:quote -->

<!-- wp:embed {"url":"https://www.youtube.com/watch?v=Zq3fR2b8kXw","type":"video","providerNameSlug":"youtube"} -->
<figure class="wp-block-embed is-type-video is-provider-youtube"><div class="wp-block-embed__wrapper">
https://www.youtube.com/watch?v=Zq3fR2b8kXw
</div></figure>
<!-- /wp:embed -->

<!-- wp:html -->
<iframe src="https://www.openstreetmap.org/export/embed.html?bbox=-0.1%2C51.5%2C-0.09%2C51.51" width="600" height="450" style="border:0"></iframe>
<!-- /wp:html -->

<!-- wp:video {"id":207} -->
<figure class="wp-block-video"><video controls src="https://old.example.org/wp-content/uploads/2024/04/throwing-demo.mp4"></video></figure>
<!-- /wp:video -->

<!-- wp:separator -->
<hr class="wp-block-separator has-alpha-channel-opacity"/>
<!-- /wp:separator -->

<!-- wp:block {"ref":150} /-->

<!-- wp:latest-posts {"postsToShow":3} /-->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="https://old.example.org/2024/03/opening-the-new-kiln-room/">See the kiln room</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons -->]]></content:encoded>
		<excerpt:encoded><![CDATA[]]></excerpt:encoded>
