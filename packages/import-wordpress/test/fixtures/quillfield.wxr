			<wp:meta_value><![CDATA[[{"id":"a1","elType":"section","settings":{"_element_id":"intro"},"elements":[{"id":"a2","elType":"column","settings":{"_column_size":100},"elements":[{"id":"a3","elType":"widget","widgetType":"heading","settings":{"title":"Make something with your hands","header_size":"h1"}},{"id":"a4","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Evening and weekend classes for complete beginners and returning potters, in a small studio with six wheels.</p>"}},{"id":"a5","elType":"widget","widgetType":"button","settings":{"text":"Book a class","link":{"url":"https://old.example.org/opening-hours/"}}}]}]},{"id":"b1","elType":"section","settings":{},"elements":[{"id":"b2","elType":"column","settings":{"_column_size":33},"elements":[{"id":"b3","elType":"widget","widgetType":"icon-box","settings":{"selected_icon":{"value":"fas fa-hand-paper","library":"fa-solid"},"title_text":"Throwing","description_text":"Learn to centre, open and pull a cylinder on the wheel."}}]},{"id":"b4","elType":"column","settings":{"_column_size":33},"elements":[{"id":"b5","elType":"widget","widgetType":"icon-box","settings":{"selected_icon":{"value":"fas fa-shapes","library":"fa-solid"},"title_text":"Hand-building","description_text":"Pinch, coil and slab pots without a wheel."}}]},{"id":"b6","elType":"column","settings":{"_column_size":33},"elements":[{"id":"b7","elType":"widget","widgetType":"icon-box","settings":{"selected_icon":{"value":"fas fa-fill-drip","library":"fa-solid"},"title_text":"Glazing","description_text":"Mix, dip and layer the studio's own glazes."}}]}]},{"id":"c1","elType":"section","settings":{},"elements":[{"id":"c2","elType":"column","settings":{"_column_size":100},"elements":[{"id":"c3","elType":"widget","widgetType":"testimonial","settings":{"testimonial_content":"I came for one evening and stayed for three terms.","testimonial_name":"Mara Ellison","testimonial_job":"Weekend class, 2024","testimonial_image":{"url":"https://old.example.org/wp-content/uploads/2024/02/mara.png","id":208}}}]}]},{"id":"d1","elType":"section","settings":{},"elements":[{"id":"d2","elType":"column","settings":{"_column_size":100},"elements":[{"id":"d3","elType":"widget","widgetType":"heading","settings":{"title":"Questions people ask","header_size":"h2"}},{"id":"d4","elType":"widget","widgetType":"accordion","settings":{"tabs":[{"tab_title":"Do I need any experience?","tab_content":"<p>None at all. Most people in the evening class have never touched clay.</p>"},{"tab_title":"What should I wear?","tab_content":"<p>Clothes you don't mind getting muddy, and short nails.</p>"},{"tab_title":"Can I take my pots home?","tab_content":"<p>Yes — after they've been fired twice, about three weeks later.</p>"}]}}]}]},{"id":"e1","elType":"container","settings":{"flex_direction":"row"},"elements":[{"id":"e2","elType":"container","settings":{},"elements":[{"id":"e3","elType":"widget","widgetType":"price-table","settings":{"heading":"Evening class","price":"180","currency_symbol":"pound","period":"per term","features_list":[{"item_text":"Eight sessions"},{"item_text":"Clay and firing included"}],"button_text":"Book evenings","link":{"url":"https://old.example.org/opening-hours/"}}}]},{"id":"e4","elType":"container","settings":{},"elements":[{"id":"e5","elType":"widget","widgetType":"price-table","settings":{"heading":"Weekend course","price":"95","currency_symbol":"pound","period":"per weekend","features_list":[{"item_text":"Two full days"},{"item_text":"Lunch included"}],"button_text":"Book a weekend","link":{"url":"https://old.example.org/opening-hours/"},"show_ribbon":"yes"}}]}]},{"id":"f1","elType":"section","settings":{},"elements":[{"id":"f2","elType":"column","settings":{"_column_size":100},"elements":[{"id":"f3","elType":"widget","widgetType":"heading","settings":{"title":"Supported by","header_size":"h4"}},{"id":"f4","elType":"widget","widgetType":"image-carousel","settings":{"carousel":[{"id":211,"url":"https://old.example.org