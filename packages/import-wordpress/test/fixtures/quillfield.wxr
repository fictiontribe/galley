		<description></description>
		<content:encoded><![CDATA[<!-- wp:paragraph -->
<p>Ideas for the open studio in July.</p>
<!-- /wp:paragraph -->

<!-- wp:image -->
<figure class="wp-block-image"><img src="https://old.example.org/wp-content/uploads/2024/04/mugs.png" alt="Four mugs in a row"/></figure>
<!-- /wp:image -->]]></content:encoded>
