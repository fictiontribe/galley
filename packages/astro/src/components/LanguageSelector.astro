---
/**
 * Accessible language switcher linking to the current page's exact translated
 * counterpart (including localized URL slugs from `galley/i18n/manifest.json`).
 *
 * Usage:
 *   <LanguageSelector />
 *   <LanguageSelector fallback="hide" showCode />
 */
import { resolvePageLocales, type I18nConfig, type I18nManifest } from "../i18n/index.js";

interface Props {
  /** Accessible label for the `<nav>` landmark. Default: "Language". */
  label?: string;
  /** What to do for languages where this page isn't translated yet: link to that language's home ("home", default) or hide it ("hide"). */
  fallback?: "home" | "hide";
  /** Show the short locale code (e.g. "ES") beside the label. */
  showCode?: boolean;
  /** Extra CSS class on the `<nav>`. */
  class?: string;
  /** Omit the built-in minimal styles so your own stylesheet styles `.galley-lang`. */
  unstyled?: boolean;
  /** Override current pathname (defaults to `Astro.url.pathname`). */
  pathname?: string;
  /** Override current locale (defaults to `Astro.currentLocale`). */
  currentLocale?: string;
  /** Optional explicit i18n config (defaults to `galley.config.json`). */
  config?: I18nConfig | null;
  /** Optional explicit manifest (defaults to `galley/i18n/manifest.json`). */
  manifest?: I18nManifest | null;
  /** Site root folder (defaults to `process.cwd()`). */
  root?: string;
}

const {
  label = "Language",
  fallback = "home",
  showCode = false,
  class: className,
  unstyled = false,
  pathname = Astro.url.pathname,
  currentLocale = Astro.currentLocale,
  config,
  manifest,
  root,
} = Astro.props;

const base = import.meta.env.BASE_URL || "/";
const resolved = resolvePageLocales({ pathname, currentLocale, base, config, manifest, root });
const items = resolved.configured
  ? resolved.alternates
      .map((item) => {
        const target = item.exists && item.path ? item.path : fallback === "home" ? item.fallbackPath : null;

        return target ? { ...item, target } : null;
      })
      .filter((item): item is NonNullable<typeof item> => item !== null)
  : [];
---

{
  items.length >= 2 ? (
    <nav class:list={["galley-lang", !unstyled && "galley-lang--styled", className]} aria-label={label}>
      <ul class="galley-lang__list">
        {items.map((item) => (
          <li class="galley-lang__item">
            <a
              class:list={["galley-lang__link", item.active && "galley-lang__link--active"]}
              href={item.target}
              lang={item.code}
              hreflang={item.code}
              dir={item.direction}
              aria-current={item.active ? "page" : undefined}
            >
              <span class="galley-lang__label">{item.label}</span>
              {showCode ? <span class="galley-lang__code">{item.code.toUpperCase()}</span> : null}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  ) : null
}

<style>
  .galley-lang--styled .galley-lang__list {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .galley-lang--styled .galley-lang__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.55rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    line-height: 1.25;
    text-decoration: none;
    color: inherit;
    opacity: 0.78;
    transition: opacity 120ms ease, background-color 120ms ease;
  }

  .galley-lang--styled .galley-lang__link:hover,
  .galley-lang--styled .galley-lang__link:focus-visible {
    opacity: 1;
    background-color: color-mix(in srgb, currentColor 8%, transparent);
  }

  .galley-lang--styled .galley-lang__link--active {
    opacity: 1;
    font-weight: 600;
    background-color: color-mix(in srgb, currentColor 12%, transparent);
  }

  .galley-lang--styled .galley-lang__code {
    font-size: 0.72em;
    letter-spacing: 0.04em;
    opacity: 0.7;
  }
</style>
