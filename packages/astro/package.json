{
  "name": "@galley/astro",
  "version": "0.4.1",
  "private": true,
  "description": "The Galley site kit for Astro: forms that send to HubSpot, Marketo, Salesforce, Account Engagement, a webhook or Galley's inbox; consent-aware third-party scripts (GTM, GA4 and more) managed from one file; and a Dev Toolbar app that opens the page in Galley, the open-source, git-based AI CMS.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Fiction Tribe",
  "homepage": "https://galley.fictiontribe.com/astro/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fictiontribe/galley.git",
    "directory": "packages/astro"
  },
  "bugs": "https://github.com/fictiontribe/galley/issues",
  "keywords": [
    "astro-integration",
    "withastro",
    "astro",
    "astro-component",
    "dev-toolbar",
    "devtools",
    "forms",
    "analytics",
    "consent",
    "cms",
    "galley"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./components": {
      "types": "./src/components/index.d.ts",
      "default": "./src/components/index.js"
    },
    "./schema": {
      "types": "./types/schema.d.ts",
      "default": "./src/schema.js"
    },
    "./catalog": {
      "types": "./types/catalog.d.ts",
      "default": "./src/catalog.js"
    },
    "./client": {
      "types": "./types/client.d.ts",
      "default": "./src/client/forms.js"
    },
    "./kit": {
      "types": "./src/kit.d.ts"
    },
    "./forms.css": "./src/forms/forms.css",
    "./toolbar-app": "./src/toolbar-app.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "scripts/vendor.mjs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": [
    "./src/client/forms.js",
    "**/*.css",
    "**/*.astro"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "sync": "node scripts/sync-contract.mjs && node scripts/build-inline.mjs",
    "size": "node scripts/size.mjs",
    "vendor": "node scripts/vendor.mjs"
  },
  "devDependencies": {
    "astro": "^7.4.13",
    "happy-dom": "^21.0.4"
  }
}
