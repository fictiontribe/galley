{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/me", "destination": "/profile.html", "permanent": false },
    { "source": "/user", "destination": "/api/user", "statusCode": 301 },
    { "source": "/blog/:path*", "destination": "/news/:path*" },
    { "source": "/posts/:path(\\d{1,})", "destination": "/news/:path" },
    { "source": "/specific/:path*", "has": [{ "type": "query", "key": "page", "value": "home" }], "destination": "/another/:path*", "permanent": false }
  ]
}
