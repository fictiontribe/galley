{
  "name": "@galley/web",
  "version": "0.4.8",
  "private": true,
  "type": "module",
  "description": "Galley web UI.",
  "exports": {
    "./app": "./src/app/App.tsx",
    "./additions": "./src/additions/index.ts",
    "./ui": "./src/ui/index.ts",
    "./styles": "./src/styles/index.css",
    "./vite": {
      "types": "./vite.preset.d.mts",
      "default": "./vite.preset.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "GALLEY_MOCK=1 vite",
    "build": "vite build",
    "build:demo": "node demo/scripts/build.mjs",
    "demo:publish": "node demo/scripts/publish.mjs",
    "demo:check": "node demo/scripts/publish.mjs --check",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test-dom.json && tsc --noEmit -p tsconfig.demo.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@galley/core": "workspace:*",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "dompurify": "^3.0.0",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
