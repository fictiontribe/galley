{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["vite.config.ts", "vitest.config.ts", "mock", "test"],
  // The install tests render the app in a browser-like page: tsconfig.test-dom.json checks them.
  "exclude": ["test/install", "test/hosting", "test/ui"]
}
