  "whiteLabel": {
    "input": "--accent",
    "default": "#2E2BFF",
    "rules": {
      "accent-on": "Near-white (#FEFEFE) when the accent's relative luminance Y < 0.199, otherwise near-black (#1A1A1A).",
      "accent-fill": "The accent itself, except when 0.175 ≤ Y < 0.227 (where neither text colour reaches 4.5:1): then scaled in linear light to Y = 0.175 (dark side) or mixed toward white to Y = 0.2274 (light side).",
      "accent-hover": "color-mix(in oklab, accent-fill 86%, away) where away is black if accent-on is white, white otherwise.",
      "accent-pressed": "color-mix(in oklab, accent-fill 72%, away).",
      "accent-subtle": "color-mix(in srgb, accent 10%, surface-paper). accent-subtle-hover 16%, accent-line 45%, accent-guide 22%, selection-bg 22%.",
      "accent-line (dark)": "color-mix(in srgb, accent-text 50%, surface-paper)",
      "accent-text (light)": "oklch(from accent min(l, 0.45) c h)",
      "accent-text (dark)": "oklch(from color-mix(in srgb, accent, ink-primary 45%) max(l, 0.76) c h)"
    },
    "verified": "251 accents (24 hues × 2 saturations × 5 lightnesses + 11 extremes): on-accent ≥ 4.59:1 on fill/hover/pressed; accent-text ≥ 4.83:1 (light) and ≥ 7.04:1 (dark) on paper, raised and sunken."
