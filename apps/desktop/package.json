{
  "name": "@galley/desktop",
  "version": "0.4.9",
  "private": true,
  "type": "module",
  "description": "The desktop app: a Tauri 2 shell that runs the server privately and shows its UI in a native window.",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/fictiontribe/galley/issues"
  },
  "scripts": {
    "dev": "tauri dev",
    "bundle": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "prepare-sidecar": "node scripts/prepare-sidecar.mjs",
    "icons": "node scripts/render-icon.mjs && tauri icon src-tauri/icons/source/app-icon-1024.png --output src-tauri/icons",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:shutdown": "node scripts/shutdown-e2e.mjs",
    "test:sidecar": "node scripts/sidecar-e2e.mjs -- node ../../packages/cli/bin/galley.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6"
  }
}
