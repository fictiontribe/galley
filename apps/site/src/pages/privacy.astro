---
import Site from "../layouts/Site.astro";
import PageHead from "../components/PageHead.astro";
import { getPage } from "../lib/pages";

const { data: p, html } = await getPage("privacy");
---

<Site title={p.title} description={p.description}>
  <div class="wrap">
    <PageHead eyebrow={p.eyebrow} heading={p.heading} lead={p.lead} />
    <div class="prose" set:html={html} />
  </div>
</Site>
