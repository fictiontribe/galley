---
// /how-to/ — every guide in src/data/howto.json, each with its first picture.
// The words around them are src/content/pages/how-to.md. Above the cards, a
// thin filter (components/HowtoFilter.astro) over the groups listed under
// `filter` in that file; a group's address is /how-to/?show=<its id>.
import Site from "../layouts/Site.astro";
import { getPage } from "../lib/pages";
import { inline } from "../lib/markdown";
import { site } from "../lib/site";
import HowtoFilter from "../components/HowtoFilter.astro";
import { demo } from "../lib/demo";
import { firstPicture, howtoHref, howtoGroups, howtos } from "../lib/howto";

const { data: p } = await getPage("how-to");
const { groups, groupOf } = howtoGroups(p.filter);
const cards = howtos.map((g) => ({ g, first: firstPicture(g), group: groupOf.get(g.slug) }));
// A filter with one choice is no filter.
const filtered = groups.length > 1;
---

<Site title={p.title} description={p.description} noindex={p.noindex}>
  <section class:list={["howto-index", filtered && "howto-index--filtered"]} aria-labelledby="howto-h">
    <div class="wrap">
      <div class="page-head">
        <h1 class="h1" id="howto-h" set:html={inline(p.heading)} />
        <p class="lead">{p.lead}</p>
        {demo.on && <p class="howto-index__demo">{site.ui.demoLine} <a class="link link--accent" href={demo.href}>{site.ui.demoOpen}</a></p>}
      </div>
    </div>
    {filtered && <HowtoFilter groups={groups} total={cards.length} />}
    <div class="wrap">
      <ol class="howto-cards" data-howto-cards>
        {
          cards.map(({ g, first, group }, i) => (
            <li class="howto-card" data-group={group}>
              <a href={howtoHref(g.slug)}>
                {first && (
                  <span class:list={["frame", "howto-card__frame", first.pic.width >= 1200 && "howto-card__frame--window"]}>
                    <span class="stage">
                      <span class="shot" style={`--w:${first.pic.width}px`}>
                        <img src={first.pic.src} srcset={first.pic.srcset} sizes={first.pic.width >= 1200 ? "(max-width: 639px) 150vw, (max-width: 1023px) 70vw, 620px" : `(max-width: 639px) calc(100vw - 72px), (max-width: 1023px) calc(50vw - 80px), ${Math.min(first.pic.width, 360)}px`} width={first.pic.width} height={first.pic.height} alt="" loading={i < 3 ? "eager" : "lazy"} decoding="async" />
                      </span>
                    </span>
                  </span>
                )}
                <h2 class="howto-card__t">{g.title}</h2>
                <p class="howto-card__d">{g.summary}</p>
                <p class="howto-card__n">{g.steps.length === 1 ? site.ui.howtoStepsOne : site.ui.howtoSteps.replace("{n}", String(g.steps.length))}</p>
              </a>
            </li>
          ))
        }
      </ol>
      {p.tour && <p class="howto-index__more" data-howto-after>{p.tour.text} <a class="link link--accent" href={p.tour.href}>{p.tour.label}</a></p>}
    </div>
  </section>
</Site>
