---
// A capture panel. With `rec`, it holds a looping recording and its small
// round pause button (the loop starts only in view, and never by itself when
// the visitor prefers less motion).
import { site } from "../lib/site";

interface Props {
  class?: string;
  rec?: boolean;
}
const { class: cls, rec = false } = Astro.props;
---

<div class:list={["frame", cls, rec && "rec"]} data-rec={rec ? "" : undefined}>
  <div class="stage"><slot /></div>
  {
    rec && (
      <button type="button" class="loop-pause" data-galley-agent="skip" data-rec-toggle aria-label={site.ui.play} data-play={site.ui.play} data-pause={site.ui.pause} hidden>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path class="i-pause" d="M5 3.5v9M11 3.5v9" /><path class="i-play" d="M5 3.2v9.6L12.8 8z" /></svg>
      </button>
    )
  }
</div>
