---
import { inline } from "../lib/markdown";
interface Props { eyebrow?: string; heading: string; lead?: string }
const { eyebrow, heading, lead } = Astro.props;
---

<header class="page-head">
  <h1 class="h1" set:html={inline(heading)} />
  {lead && <p class="lead" set:html={inline(lead)} />}
  {/* The small label sits under the words, as a quiet line, never above the headline. */}
  {eyebrow && <p class="head-note">{eyebrow}</p>}
</header>
