---
// The starters: each one a page of its own home page set in the tan capture
// panel, its looks as buttons on the panel that swap the picture, then what
// it is, then the one command that starts it. An item with no starter folder
// is a plain card (one in progress, or "make your own", set as a blank page
// inside crop marks).
//   feature — the first starter tall beside the others, then the page builder line
//   gallery — two columns, the starters' own page
//   row     — three across, picture and looks, name and one line; no commands (the home page)
//
// Pictures, in order: the item's `tall` captures (public/sites/<tall>-<look>.webp),
// else the site's capture of the starter (public/sites/<short>-<look>.webp, the top
// 1600 px of its home page in a 1280 px window — one treatment for every starter),
// else the starter's own preview (starters/<id>/galley/previews/).
import { existsSync } from "node:fs";
import { join } from "node:path";
import Panel from "../Panel.astro";
import Shot from "../Shot.astro";
import Command from "../Command.astro";
import { starterCommand } from "../../lib/install";
import { getStarter, sectionThumb } from "../../lib/starters";
import { siteShot } from "../../lib/media";
import { badgeOf } from "../../lib/status";
import { inline } from "../../lib/markdown";
import { fill, site } from "../../lib/site";

const { s, block, first } = Astro.props;
const H = first ? "h1" : "h2";
const Hi = first ? "h2" : "h3";
const hid = `${s.id ?? "starters"}-h`;
const t = site.ui;
const captured = (name: string) => existsSync(join(process.cwd(), "public", "sites", `${name}.webp`));
const items = s.items.map((item: { starter?: string; tall?: string; status?: string }, i: number) => {
  const st = item.starter ? getStarter(item.starter) : null;
  const tall = s.layout === "feature" && i === 0;
  const looks = (st?.looks ?? []).map((look) => {
    const name = [tall && item.tall ? `${item.tall}-${look.id}` : null, `${st!.short}-${look.id}`].find((n) => n && captured(n));
    const pic = name ? siteShot(name) : null;
    return pic
      ? { ...look, src: pic.src, srcset: pic.srcset, width: pic.width, height: pic.height }
      : { ...look, src: look.preview, srcset: undefined };
  });
  const run = st ? starterCommand({ short: st.short, dir: st.id }) : null;
  return { ...item, looks, tall, badge: badgeOf(item.status), run, inside: st ? fill(`{repository}/tree/${site.repositoryBranch}/starters/${st.id}`) : null };
});
const shown = items.filter((item: any) => item.looks.length);
const others = items.filter((item: any) => !item.looks.length);
const sizes = (tall: boolean) =>
  s.layout === "row" ? "(max-width: 639px) calc(100vw - 80px), (max-width: 1023px) 44vw, 400px" : s.layout === "gallery" ? "(max-width: 639px) calc(100vw - 80px), (max-width: 1440px) 42vw, 548px" : tall ? "(max-width: 639px) calc(100vw - 80px), (max-width: 1023px) 86vw, 440px" : "(max-width: 639px) calc(100vw - 80px), (max-width: 1023px) 40vw, 650px";
---

<section class="section wrap" id={s.id} aria-labelledby={hid} data-galley-block={block.key} data-galley-block-type={block.type}>
  <div class:list={["head", s.link && "head--row"]}>
    <div class="head" style="margin:0">
      <H class:list={[first ? "h1" : "h2"]} id={hid} set:html={inline(s.heading)} />
      <p class="lead">{fill(s.text)}</p>
    </div>
    {s.link && <p><a class="link" href={fill(s.link.href)}>{s.link.label}</a></p>}
  </div>
  <div class:list={["starters", `starters--${s.layout}`]}>
    {
      shown.map((item: any) => (
        <article class:list={["starter", item.tall && "starter--tall"]} data-starter aria-labelledby={`${hid}-${item.starter}`}>
          <div class="starter__view">
            <Panel class="starter__frame">
              <div class="shot starter__shot">
                {item.looks.map((look: any, i: number) => (
                  <img src={look.src} srcset={look.srcset} sizes={look.srcset ? sizes(item.tall) : undefined} width={look.width} height={look.height} alt={t.lookAlt.replace("{name}", item.name).replace("{look}", look.label)} loading="lazy" decoding="async" data-look={look.id} hidden={i !== 0} />
                ))}
              </div>
            </Panel>
            <div class="looks" data-galley-agent="skip" role="group" aria-label={t.lookOf.replace("{name}", item.name)}>
              {item.looks.map((look: any, i: number) => (
                <button class="look" type="button" data-look-to={look.id} aria-pressed={i === 0 ? "true" : "false"}>
                  <span class="look__sw" aria-hidden="true"><span style={`background:${look.swatches[0]}`} /><span style={`background:${look.swatches[2] ?? look.swatches[1]}`} /></span>
                  {look.label}
                </button>
              ))}
            </div>
          </div>
          <div class="starter__body">
            <Hi class="starter__name" id={`${hid}-${item.starter}`}>{item.name}</Hi>
            <p class="starter__kind">
              <span class="label">{item.kind}</span>
              {item.badge && <span class:list={["badge", `badge--${item.badge.status}`]}>{item.badge.label}</span>}
            </p>
            <p class="starter__meta">{fill(item.text)}</p>
            {item.run && s.layout !== "row" && (
              <div class="starter__run">
                <Command lines={[item.run.command]} label={`${item.run.note}: ${item.name}`} />
                <p class="starter__foot">
                  <span>{item.run.note}</span>
                  <a class="link" href={item.inside}>{t.inside}<span class="sr">: {item.name}</span></a>
                </p>
              </div>
            )}
          </div>
        </article>
      ))
    }
    {
      others.length > 0 && s.layout === "feature" && (
        <div class="starters__aside">
          {others.map((item: any) => (
            <article class="starter starter--soon">
              <div class="starter__body">
                <Hi class="starter__name">{item.name}</Hi>
                <p class="starter__kind"><span class="label">{item.kind}</span>{item.badge && <span class:list={["badge", `badge--${item.badge.status}`]}>{item.badge.label}</span>}</p>
                <p class="starter__meta">{fill(item.text)}</p>
                {item.link && <p><a class="link link--accent" href={fill(item.link.href)}>{item.link.label}</a></p>}
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
  {s.note && <p class="caption starters__note">{fill(s.note)}</p>}
  {
    others.length > 0 && s.layout === "gallery" && (
      <div class="own-list">
        {others.map((item: any) => (
          <article class="own">
            <div class="own__name">
              <Hi class="starter__name">{item.name}</Hi>
              <p class="starter__kind"><span class="label">{item.kind}</span>{item.badge && <span class:list={["badge", `badge--${item.badge.status}`]}>{item.badge.label}</span>}</p>
            </div>
            <p class="starter__meta">{fill(item.text)}</p>
            {item.link && <p class="own__go"><a class="link link--accent" href={fill(item.link.href)}>{item.link.label}</a></p>}
          </article>
        ))}
      </div>
    )
  }
  {
    s.builder && (
      <div class="builder">
        <div class="builder__text">
          {badgeOf(s.builder.status) && <span class:list={["badge", `badge--${badgeOf(s.builder.status)!.status}`]}>{badgeOf(s.builder.status)!.label}</span>}
          <p class="lead">{fill(s.builder.text)}</p>
          {s.builder.starter && s.builder.sections.length > 0 && (
            <ul class="lib" aria-label={s.builder.sectionsLabel}>
              {s.builder.sections.map((type: string) => {
                const t = sectionThumb(s.builder.starter, type);
                return (
                  <li>
                    <img src={t.src} width={t.width} height={t.height} alt="" loading="lazy" decoding="async" />
                    <span>{t.label}</span>
                  </li>
                );
              })}
            </ul>
          )}
        </div>
        <Panel rec={s.builder.visual.kind === "recording"}>
          <Shot visual={s.builder.visual} />
        </Panel>
      </div>
    )
  }
</section>
