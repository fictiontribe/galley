---
// A page's first screen.
//   showcase — the live site with Galley's proof laid over it (the home page)
//   split    — the words beside one picture
//   text     — the words alone
import Panel from "../Panel.astro";
import Shot from "../Shot.astro";
import Actions from "../Actions.astro";
import Command from "../Command.astro";
import { firstCommand, published } from "../../lib/install";
import { inline } from "../../lib/markdown";
import { fill, site } from "../../lib/site";
import { demo } from "../../lib/demo";

const { s, block, first } = Astro.props;
const H = first ? "h1" : "h2";
const hid = `${s.id ?? "hero"}-h`;
const note = published && s.notePublished !== undefined ? s.notePublished : s.note;
const isRec = s.visual?.kind === "recording";
// `demo`: the label of a second action to the in-browser demo, shown only while site.json → demo is available.
// It takes the place of the quieter link (`secondary`) when both are set.
const secondary = s.demo && demo.on ? { label: s.demo, href: demo.href, note: site.ui.demoSmall } : s.secondary;
// Short sentences in a heading ("Prompt it. Proof it. Publish it.") wrap whole, never mid-sentence.
const heading = inline(s.heading).split(/(?<=[.?])\s+(?=[A-Z])/).map((part) => `<span class="nowrap-s">${part}</span>`).join(" ");
---

<section class:list={["hero wrap", `hero--${s.layout}`, s.align === "center" && "hero--centered"]} id={s.id} aria-labelledby={hid} data-galley-block={block.key} data-galley-block-type={block.type}>
  {s.notice && <a class="notice" href={fill(s.notice.href)}><span>{fill(s.notice.label)}</span></a>}
  {
    s.layout === "showcase" ? (
      <>
        <div class="hero__top">
          {s.eyebrow && <p class="label">{s.eyebrow}</p>}
          <H class="h1" id={hid} set:html={heading} />
          <div class="hero__row">
            <p class="lead">{fill(s.text)}</p>
            <div class="hero__side">
              <Actions cta={s.cta} secondary={secondary} />
              {note && <p class="hero__note">{fill(note)}</p>}
              {s.command && (
                <Command lines={[firstCommand()]} />
              )}
              {s.copyFile && <button type="button" data-galley-agent="skip" class="link link--plain copyfile" data-copy-file={s.copyFile.href}>{s.copyFile.label}</button>}
            </div>
          </div>
        </div>
        <figure>
          <Panel class="showcase">
            {s.visual && <Shot visual={s.visual} class="site" bar={s.labels?.site} sizes="(max-width: 639px) calc(100vw - 72px), (max-width: 1023px) 76vw, 860px" eager />}
            {s.overlay && <Shot visual={s.overlay} class="over" bar={s.labels?.overlay} sizes="(max-width: 639px) 720px, 1000px" eager />}
          </Panel>
          {s.caption && <figcaption class="caption">{fill(s.caption)}</figcaption>}
        </figure>
      </>
    ) : (
      <div class="hero__grid">
        <div class="hero__text">
          {s.eyebrow && <p class="label">{s.eyebrow}</p>}
          <H class="h1" id={hid} set:html={heading} />
          <p class="lead">{fill(s.text)}</p>
          <Actions cta={s.cta} secondary={secondary} />
          {note && <p class="hero__note">{fill(note)}</p>}
          {s.command && (
            <Command lines={[firstCommand()]} />
          )}
        </div>
        {s.visual && (
          <figure>
            <Panel rec={isRec}>
              <Shot visual={s.visual} eager={!isRec} />
            </Panel>
            {s.caption && <figcaption class="caption">{fill(s.caption)}</figcaption>}
          </figure>
        )}
      </div>
    )
  }
</section>
