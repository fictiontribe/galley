---
// The film: its poster first, nothing of the video loaded until someone
// presses play; then it plays with controls and English captions. Chapters
// jump to a point in it.
import { existsSync } from "node:fs";
import { join } from "node:path";
import { noteMissing, webpSize } from "../../lib/media";
import { inline } from "../../lib/markdown";
import { fill } from "../../lib/site";
import Glyph from "../Glyph.astro";
import type { IconName } from "../../../../../brand/icons";

const { s, block, first } = Astro.props;
const H = first ? "h1" : "h2";
const hid = `${s.id ?? "film"}-h`;
const base = `/video/${s.video}`;
// A film section just added in the editor names no film yet. It then shows its
// words, and in the preview a place where the film will go, instead of failing the page.
const posterFile = s.video ? join(process.cwd(), "public", "video", `${s.video}-poster.webp`) : "";
const poster = posterFile && existsSync(posterFile) ? webpSize(posterFile) : null;
if (!poster) {
  if (s.video) noteMissing(`video/${s.video}-poster`, "the film section shows its words without a film");
  else console.warn("[site] A film section names no video: it shows its words without a film.");
}
const empty = !poster && import.meta.env.DEV;
---

<section class:list={["section wrap", s.layout === "wide" && "film--wide"]} id={s.id} aria-labelledby={hid} data-galley-block={block.key} data-galley-block-type={block.type}>
  {
    s.layout === "wide" ? (
      <div data-film>
        <div class="head head--row film__head">
          <H class="h2" id={hid} set:html={inline(s.heading)} />
          <p class="lead">{fill(s.text)}</p>
        </div>
        {poster ? (
          <div class="film__screen">
            <video preload="none" playsinline controls poster={`${base}-poster.webp`} width={poster.width / 2} height={poster.height / 2} aria-label={s.title} data-film-video>
              <source src={`${base}.webm`} type="video/webm" />
              <source src={`${base}.mp4`} type="video/mp4" />
              <track kind="captions" src={`${base}.en.vtt`} srclang="en" label={s.captions} default />
            </video>
          </div>
        ) : (
          empty && <p class="film__screen film__empty">This section has no film yet. Add its video in the form.</p>
        )}
        {poster && s.chapters.length > 0 && (
          <ol class="film__steps" aria-label={s.chaptersLabel}>
            {s.chapters.map((c: { label: string; icon?: string; time: number; text?: string }, i: number) => (
              <li>
                <button type="button" class="film__step" data-film-seek={c.time}>
                  <span class="film__n" aria-hidden="true">{i + 1}</span>
                  <span class="film__t">{c.icon && <Glyph name={c.icon as IconName} size={20} />}{c.label}</span>
                  {c.text && <span class="film__d">{c.text}</span>}
                  <span class="film__at">{`0:${String(c.time).padStart(2, "0")}`}</span>
                </button>
              </li>
            ))}
          </ol>
        )}
        {(s.transcript || s.link) && (
          <p class="film__more">
            {s.link && <a class="link link--accent" href={fill(s.link.href)}>{s.link.label}</a>}
            {s.transcript && <a class="link" href={fill(s.transcript.href)}>{s.transcript.label}</a>}
          </p>
        )}
      </div>
    ) : (
  <div class="film__grid">
      <div class="head">
        <H class="h2" id={hid} set:html={inline(s.heading)} />
        <p class="lead">{fill(s.text)}</p>
        {s.transcript && <a class="link" href={fill(s.transcript.href)}>{s.transcript.label}</a>}
      </div>
      <div data-film>
        {poster ? (
          <div class="film__screen">
            <video preload="none" playsinline controls poster={`${base}-poster.webp`} width={poster.width / 2} height={poster.height / 2} aria-label={s.title} data-film-video>
              <source src={`${base}.webm`} type="video/webm" />
              <source src={`${base}.mp4`} type="video/mp4" />
              <track kind="captions" src={`${base}.en.vtt`} srclang="en" label={s.captions} default />
            </video>
          </div>
        ) : (
          empty && <p class="film__screen film__empty">This section has no film yet. Add its video in the form.</p>
        )}
        {
          poster && s.chapters.length > 0 && (
            <ol class="chapters" aria-label={s.chaptersLabel}>
              {s.chapters.map((c: { label: string; time: number }) => (
                <li>
                  <button type="button" data-film-seek={c.time}>
                    <span>{`0:${String(c.time).padStart(2, "0")}`}</span>
                    {c.label}
                  </button>
                </li>
              ))}
            </ol>
          )
        }
      </div>
    </div>
    )
  }
</section>

<style>
  .film__empty {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    margin: 0;
    padding: 1.5rem;
    background: none;
    border: 1px dashed currentColor;
    text-align: center;
    opacity: 0.7;
  }
</style>
