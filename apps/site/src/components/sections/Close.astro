---
// The closing card on the inked plate: a heading, one line, the actions, and
// optionally the real commands to run.
import Command from "../Command.astro";
import Output from "../Output.astro";
import { output, runCommands } from "../../lib/install";
import { inline } from "../../lib/markdown";
import { fill } from "../../lib/site";

const { s, block, first } = Astro.props;
const H = first ? "h1" : "h2";
const hid = `${s.id ?? "close"}-h`;
---

<section class="section wrap" id={s.id} aria-labelledby={hid} data-galley-block={block.key} data-galley-block-type={block.type}>
  <div class:list={["close", !s.commands && "close--solo", "rv-scale"]}>
    <div class="close__text">
      <H class="h2" id={hid} set:html={inline(s.heading)} />
      <p class="body">{fill(s.text)}</p>
      {s.points.length > 0 && <ul class="points">{s.points.map((p: string) => <li set:html={inline(p)} />)}</ul>}
      {s.commands && s.actions.length > 0 && (
        <div class="close__actions">
          {s.actions.map((a: { label: string; href: string }, i: number) => <a class:list={["btn", i === 0 ? "btn--primary" : "btn--quiet"]} href={fill(a.href)}>{a.label}</a>)}
        </div>
      )}
    </div>
    {s.commands ? (
      <div class="close__run">
        <Command lines={runCommands()} />
        <Output lines={[output.running]} />
      </div>
    ) : (
      s.actions.length > 0 && (
        <div class="close__actions">
          {s.actions.map((a: { label: string; href: string }, i: number) => <a class:list={["btn", i === 0 ? "btn--primary" : "btn--quiet"]} href={fill(a.href)}>{a.label}</a>)}
        </div>
      )
    )}
  </div>
</section>
