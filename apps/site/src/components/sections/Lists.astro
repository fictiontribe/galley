---
// Short lists side by side, each headed by a proof mark: what is written in,
// what is struck out, what changes, what stays as it is.
import { inline } from "../../lib/markdown";
import { fill } from "../../lib/site";

const { s, block, first } = Astro.props;
const H = first ? "h1" : "h2";
const Hi = first ? "h2" : "h3";
const hid = `${s.id ?? "lists"}-h`;
---

<section class="section wrap" id={s.id} aria-labelledby={hid} data-galley-block={block.key} data-galley-block-type={block.type}>
  <div class="head">
    <H class="h2" id={hid} set:html={inline(s.heading)} />
    {s.text && <p class="lead">{fill(s.text)}</p>}
  </div>
  <div class="lists">
    {
      s.columns.map((c: { title: string; mark: string; points: string[]; note?: string }) => (
        <div class:list={["list", `list--${c.mark}`]}>
          <Hi><span class:list={["mk", `mk--${c.mark}`]} aria-hidden="true" />{c.title}</Hi>
          <ul>{c.points.map((p) => <li><span set:html={inline(p)} /></li>)}</ul>
          {c.note && <p class="list__note">{fill(c.note)}</p>}
        </div>
      ))
    }
  </div>
</section>
