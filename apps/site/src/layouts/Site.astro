---
// The one shell every page uses: head, header, the page, footer. One small
// stylesheet and one small script, both from this site; nothing from any
// other origin.
import { Font } from "astro:assets";
import "../styles/site.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Scripts } from "../galley/components/index.js";
import { absoluteUrl, pageTitle, site } from "../lib/site";

interface Props {
  title: string;
  description: string;
  /** Use the title as given (the home page). */
  bareTitle?: boolean;
  noindex?: boolean;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown>;
  class?: string;
}

const { title, description, bareTitle = false, noindex = false, type = "website", jsonLd, class: bodyClass } = Astro.props;
const fullTitle = pageTitle(title, bareTitle);
const canonical = absoluteUrl(Astro.url.pathname);
const shareImage = absoluteUrl(site.shareImage);
---

<!doctype html>
<html lang={site.lang} data-copied={site.ui.copied} data-copy-failed={site.ui.copyFailed}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <Font cssVariable="--font-newsreader" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-figtree" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-plex-mono" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F6F4F0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16140F" media="(prefers-color-scheme: dark)" />
    {/* Light or dark: the visitor's system, unless the switch in the header chose (kept in localStorage "galley-theme"). Set before the first paint, so there is no flash. An engine from before light-dark() has the light colours only (tokens.css), so it is told light. */}
    <script is:inline set:html={`(()=>{const d=document.documentElement;d.dataset.js="";try{const old=!(window.CSS&&CSS.supports("color","light-dark(#000,#fff)"));const t=old?"light":localStorage.getItem("galley-theme");if(t!=="light"&&t!=="dark")return;d.dataset.theme=t;document.querySelector('meta[name="color-scheme"]').content=t;for(const m of document.querySelectorAll('meta[name="theme-color"]'))m.content=t==="dark"?"#16140F":"#F6F4F0"}catch(e){}})()`} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">{site.ui.skip}</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/site.ts";
    </script>
    <Scripts placement="body-end" />
  </body>
</html>
